04],"nb":["효율","생산성","기획안","문서","승인","협의","합의","체결"]}],"견해":[{"id":"T4-0246","de":"견해","rom":"gyeonhae","pos":"名词","lv":"T4","pr":null,"forms":"견해가 · 견해를","m":"见解、看法","ex":"그 문제에 대해 전문가들의 견해가 달라요.","x":"专家们对那个问题的看法不一。","e":"字面意思是“见解”，也就是你怎么看一件事，和中文一样。","t":"견해 比 의견 正式；常用 견해를 밝히다“表明看法”。","parts":[["견","看"],["해","理解"]],"rel":[["의견","意见"],["입장","立场"],["관점","观点"]],"a":["b017.mp3",1899360,2304,1901664,12288],"nb":["비난하다","논란","논쟁","쟁점","시각","관심사","이슈","캠페인"]}],"타박상":[{"id":"T4-0383","de":"타박상","rom":"tabaksang","pos":"名词","lv":"T4","pr":"타박쌍","forms":"타박상이 · 타박상을","m":"挫伤、撞伤","ex":"다행히 큰 부상은 없고 가벼운 타박상만 입었어요.","x":"幸好没有受重伤，只有轻微的挫伤。","e":"字面意思是“打扑伤”，也就是撞伤、挫伤。","t":"","parts":[["타","打"],["박","扑"],["상","伤"]],"rel":[["멍","淤青"],["부상","受伤"],["골절","骨折"]],"a":["b018.mp3",1037760,3456,1041216,14976],"nb":["골절","삐다","붓기","멍들다","화상","흉터","출혈","통증"]}],"대선":[{"id":"T4-0922","de":"대선","rom":"daeseon","pos":"名词","lv":"T4","pr":null,"forms":"대선이 · 대선을","m":"总统大选","ex":"다음 대선에서 누구에게 투표할지 아직 모르겠어요.","x":"下次总统大选要投给谁，我还不知道。","e":"대통령 선거“总统选举”的简称。","t":"新闻很爱用简称：총선（国会选举）、지방 선거（地方选举）。","parts":[["대","大"],["선","选"]],"rel":[["총선","国会选举"],["대통령","总统"],["투표","投票"]],"a":["b021.mp3",502752,2592,505344,13632],"nb":["의원","정당","여당","야당","총선","후보자","유권자","투표율"]}],"안심되다":[{"id":"T4-1026","de":"안심되다","rom":"ansimdoeda","pos":"动词","lv":"T4","pr":null,"forms":"안심돼요 · 안심됐어요 · 안심될 거예요 · 안심되는 (+noun)","m":"放心、安心下来","ex":"선생님 말씀을 들으니까 이제 좀 안심돼요.","x":"听了医生的话，现在比较放心了。","e":"안심“安心”+ 되다“变成”——自然而然安心下来。","t":"안심되다是因为某事而安心；안심하다多用来叫人放心：안심하세요。","parts":[["안","安"],["심","心"]],"rel":[["안심하다","放心"],["걱정되다","担心"],["마음이 놓이다","放下心来"]],"a":["b021.mp3",2126208,3744,2129952,9504],"nb":["동정","연민","안도","안심","조마조마하다","조급하다","두려움","공포"]}],"덜다":[{"id":"T4-1612","de":"덜다","rom":"deolda","pos":"动词","lv":"T4","pr":null,"forms":"덜어요 · 덜었어요 · 덜 거예요 · 더세요 (ㄹ drops)","m":"减去、拨出一部分；减轻","ex":"밥이 너무 많아서 조금 덜었어요.","x":"饭太多了，我拨出了一些。","e":"和副词 덜“少一点”有关。","t":"常见搭配：부담을 덜다“减轻负担”、걱정을 덜다“少担点心”。","parts":[],"rel":[["덜","较少"],["줄이다","减少"],["부담","负担"]],