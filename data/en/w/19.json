g"]],"a":["b007.mp3",2199840,2592,2202432,9984],"nb":["코끼리","원숭이","말","뱀","모기","애완동물","거리","속"]}],"기회":[{"id":"T2-1061","de":"기회","rom":"gihoe","pos":"noun","lv":"T2","pr":null,"forms":"기회가 · 기회를","m":"chance, opportunity","ex":"저는 다음 달에 한국에서 일할 기회가 생겼어요.","x":"I got a chance to work in Korea next month.","e":"Literally 'meeting a chance' — an opportunity.","t":"You 'catch' chances with 잡다 (기회를 잡다) and miss them with 놓치다.","parts":[["기","chance"],["회","meet"]],"rel":[["경험","experience"],["행운","good luck"],["놓치다","to miss"]],"a":["b007.mp3",2420256,2112,2422368,13248],"nb":["관계","생활비","그림자","기계","길이","높이","무게","나머지"]}],"운전기사":[{"id":"T3-0062","de":"운전기사","rom":"unjeongisa","pos":"noun","lv":"T3","pr":null,"forms":"운전기사가 · 운전기사를","m":"driver, chauffeur","ex":"버스를 타면서 운전기사님께 길을 물어봤어요.","x":"I asked the driver for directions as I got on the bus.","e":"Literally 'driving technician'.","t":"Taxi and bus drivers are politely addressed as 기사님.","parts":[["운","move"],["전","turn"],["기","skill"],["사","professional"]],"rel":[["운전하다","to drive"],["기사님","driver (polite)"],["택시","taxi"]],"a":["b008.mp3",1210272,3744,1214016,12384],"nb":["연구원","과학자","디자이너","소방관","농부","주부","아나운서","통역사"]}],"몸매":[{"id":"T3-0180","de":"몸매","rom":"mommae","pos":"noun","lv":"T3","pr":null,"forms":"몸매가 · 몸매를","m":"figure, body shape","ex":"그 모델은 몸매가 정말 날씬해요.","x":"That model has a really slim figure.","e":"몸 'body' + -매 'shape,' the same suffix as in 눈매 'shape of the eyes.'","t":"","parts":[],"rel":[["체격","build"],["날씬하다","to be slim"],["몸","body"]],"a":["b008.mp3",2804544,2304,2806848,11136],"nb":["손톱","수염","인상","체격","통통하다","매력","곱슬머리","주름"]}],"수도":[{"id":"T3-0216","de":"수도","rom":"sudo","pos":"noun","lv":"T3","pr":null,"forms":"수도가 · 수도를","m":"water supply, waterworks; tap","ex":"너무 추워서 수도가 얼어 버렸어요.","x":"It was so cold that the water pipes froze.","e":"Literally 'water path.'","t":"A different 수도 means 'capital city': 한국의 수도는 서울이에요.","parts":[["수","water"],["도","path"]],"rel":[["수돗물","tap water"],["수도꼭