","teach"],["사","teacher"]],"rel":[["선생님","teacher"],["학생","student"],["교육","education"]],"a":["b010.mp3",1360608,2112,1362720,12576],"nb":["학과","국어","체육","강사","담임","동기","동창","연구"]}],"교재":[{"id":"T3-0500","de":"교재","rom":"gyojae","pos":"noun","lv":"T3","pr":null,"forms":"교재가 · 교재를","m":"textbook, teaching materials","ex":"이 교재로 한국어를 공부하고 있어요.","x":"I'm studying Korean with this textbook.","e":"Literally 'teaching material'.","t":"","parts":[["교","teach"],["재","material"]],"rel":[["교과서","school textbook"],["책","book"],["자료","materials"]],"a":["b010.mp3",1614240,2304,1616544,10944],"nb":["암기","깨닫다","지식","상식","메모","어휘","표현하다","인간관계"]}],"감동적":[{"id":"T3-0565","de":"감동적","rom":"gamdongjeok","pos":"noun","lv":"T3","pr":null,"forms":"감동적이에요 · 감동적인 (+noun)","m":"moving, touching, inspiring","ex":"할머니가 들려주신 이야기는 정말 감동적이었어요.","x":"The story my grandmother told us was really moving.","e":"-적 = '-ic, -al': 감동적, 긍정적, 경제적.","t":"","parts":[["감","feel"],["동","move"],["적","-ic, -like"]],"rel":[["감동","being moved"],["인상적","impressive"],["슬프다","sad"]],"a":["b010.mp3",2529312,2688,2532000,13632],"nb":["만족","만족스럽다","불만","감동","당황하다","당황스럽다","억울하다","서운하다"]}],"머무르다":[{"id":"T3-0767","de":"머무르다","rom":"meomureuda","pos":"verb","lv":"T3","pr":null,"forms":"머물러요 · 머물렀어요 · 머무를 거예요 · 머무르세요 (르 irregular)","m":"to stay, to remain","ex":"여행 중에 작은 호텔에 일주일 동안 머물렀어요.","x":"During the trip, I stayed at a small hotel for a week.","e":"","t":"The short form 머물다 is just as common: 머물 거예요, 머물고 있어요.","parts":[],"rel":[["머물다","to stay (short form)"],["묵다","to stay (at lodging)"],["떠나다","to leave"]],"a":["b011.mp3",2555808,2592,2558400,13536],"nb":["줄이다","대하다","돌리다","맞추다","묶다","바라보다","반복하다","발견하다"]}],"평화롭다":[{"id":"T3-0820","de":"평화롭다","rom":"pyeonghwaropda","pos":"adjective","lv":"T3","pr":"평화롭따","forms":"평화로워요 · 평화로웠어요 · 평화로운 (+noun) (ㅂ irregular)","m":"peaceful","ex":"시골 마을은 조용하고 평화로워요.","x":"The country village is quiet and peaceful.","e":"-롭다 turns nouns into adjectives: 평화롭다, 자유롭다, 지혜롭다.","t":"","part