eak.","e":"Literally 'dark and gloomy'.","t":"","parts":[["암","dark"],["울","gloomy"]],"rel":[["우울하다","depressed"],["막막하다","hopeless"],["희망차다","hopeful"]],"a":["b053.mp3",1874784,2880,1877664,11232],"nb":["스산하다","시시콜콜하다","아연하다","아찔하다","애잔하다","야릇하다","어스름하다","엄연하다"]}],"금란지교":[{"id":"T6-2440","de":"금란지교","rom":"geumnanjigyo","pos":"noun","lv":"T6","pr":"금난지교","forms":"금란지교가 · 금란지교를","m":"a very close, precious friendship","ex":"그들은 어려움 속에서 금란지교를 쌓았습니다.","x":"They built a precious friendship through hard times.","e":"Friendship strong as gold and fragrant as orchids.","t":"Pronounced [금난지교] — ㄹ becomes ㄴ after ㅁ.","parts":[["금","gold"],["란","orchid"],["지","of"],["교","friendship"]],"rel":[["우정","friendship"],["관포지교","lifelong friendship"],["문경지교","friendship unto death"]],"a":["b055.mp3",217920,3744,221664,12288],"nb":["구밀복검","군웅할거","권모술수","금과옥조","금석지감","기호지세","낙화유수","난형난제"]}]}