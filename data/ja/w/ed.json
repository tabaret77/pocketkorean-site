スや報告でよく使います。","parts":[["현","現れる"],["재","ある"]],"rel":[["과거","過去"],["미래","未来"],["지금","今"]],"a":["b006.mp3",730848,2400,733248,11328],"nb":["최근","옛날","예전","과거","미래","나중","앞으로","이따가"]}],"하하":[{"id":"T2-9035","de":"하하","rom":"haha","pos":"感動詞","lv":"T2","pr":null,"forms":"하하 + 웃다 · longer: 하하하","m":"ははは（豪快な笑い声）","ex":"그 얘기를 듣고 다들 하하 웃었어요.","x":"その話を聞いて、みんな「ははは」と笑いました。","e":"開けっぴろげな豪快な笑いを表す의성어（擬声語）です。暗い母音の허허は、年配の男性らしい低く落ち着いた笑いです。","t":"メッセージでは、ㅎㅎはやわらかく親しみのある笑い、ㅋㅋは「笑」や「w」に近い感じです。","parts":[],"rel":[["웃다","笑う"],["웃음","笑い"],["히히","ひひ、えへへ"]],"a":["b062.mp3",0,1656,1656,10368],"nb":["심다","동그랗다","네모","드럼","멍멍","야옹","똑똑","냠냠"]}],"시설":[{"id":"T3-0232","de":"시설","rom":"siseol","pos":"名詞","lv":"T3","pr":null,"forms":"시설이 · 시설을","m":"施設、設備","ex":"이 아파트는 운동 시설이 잘 되어 있어요.","x":"このマンションは運動施設が充実しています。","e":"漢字で「施設」。日本語の「施設（しせつ）」と同じです。","t":"","parts":[["시","施す"],["설","設ける"]],"rel":[["편의 시설","生活便利施設"],["설치","設置"],["건물","建物"]],"a":["b009.mp3",613728,2400,616128,14016],"nb":["재활용하다","음식물 쓰레기","불편","조건","구조","낡다","오래되다","주민"]}],"보호하다":[{"id":"T3-0457","de":"보호하다","rom":"bohohada","pos":"動詞","lv":"T3","pr":null,"forms":"보호해요 · 보호했어요 · 보호할 거예요 · 보호하세요","m":"保護する、守る","ex":"선크림은 햇빛으로부터 피부를 보호해 줘요.","x":"日焼け止めは日差しから肌を守ってくれます。","e":"漢字で「保護」＋-하다。日本語の「保護する」と同じです。","t":"文型：A로부터 B를 보호하다＝AからBを守る。","parts":[["보","保つ"],["호","守る"]],"rel":[["보호","保護"],["지키다","守る"],["보호자","保護者"]],"a":["b010.mp3",1018272,3264,1021536,12864],"nb":["태양","일회용품","플라스틱","보호","개발","개발하다","재해","홍수"]}],"인간관계":[{"id":"T3-0504","de":"인간관계","rom":"ingangwangye","pos":"名詞","lv":"T3","pr":null,"forms":"인간관계가 · 인간관계를","m":"人間関係","ex":"회사 생활에서는 인간관계가 정말 중요해요.","x":"会社生活では人間関係が本当に大切です。","e":"漢字で「人間關係」。日本語の「人間関係（にんげんかんけい）」と同じです。","t":"계はふつう[게]と発音されます：[인간관게]。","parts":[["인","人"],["간","間"],["관","関わる"],["계","つなぐ"]],"rel":[["관계","関係"],["사람","人"],["친구","友達"]],"a":["b010.mp3",1670016,4608,1674624,12768],"nb":["교재","메모","어휘","표현하다","친하다","친해지다","연애","고백"]}],"불안":[{"id":"T3-0576","de":"불안","rom":"buran","pos":"名詞","lv":"T3","pr":"부란","forms":"불안이 