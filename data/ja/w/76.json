{"좋아하다":[{"id":"T1-528","de":"좋아하다","rom":"joahada","pos":"動詞","lv":"T1","pr":"조아하다","forms":"좋아해요 · 좋아했어요 · 좋아할 거예요 · 좋아하세요","m":"好きだ、好む","ex":"저는 매운 음식을 좋아해요.","x":"私は辛い料理が好きです。","e":"좋다（よい）＋-아하다（気持ちを表す）。좋아요＝いいです、좋아해요＝好きです。","t":"좋아하다は을/를をとり（음식을 좋아해요）、좋다は이/가をとります（음식이 좋아요）。日本語の「〜が好き」につられて가を使わないように。[조아하다]と発音。","parts":[],"rel":[["좋다","よい"],["싫어하다","嫌う"],["사랑하다","愛する"]],"a":["b001.mp3",2497824,3360,2501184,7392],"nb":["하다","되다","알다","모르다","싫어하다","사랑하다","기다리다","부르다"]}],"가볍다":[{"id":"T1-639","de":"가볍다","rom":"gabyeopda","pos":"形容詞","lv":"T1","pr":"가볍따","forms":"가벼워요 · 가벼웠어요 · 가벼운 (+noun) (ㅂ irregular)","m":"軽い","ex":"이 노트북은 아주 가벼워요.","x":"このノートパソコンはとても軽いです。","e":"ㅂが우に変わります：가벼워요。反対は무겁다。","t":"","parts":[],"rel":[["무겁다","重い"],["가방","かばん"]],"a":["b002.mp3",869376,3168,872544,7488],"nb":["낮다","넓다","좁다","무겁다","빠르다","느리다","멀다","가깝다"]}],"구입하다":[{"id":"T2-0005","de":"구입하다","rom":"guipada","pos":"動詞","lv":"T2","pr":"구이파다","forms":"구입해요 · 구입했어요 · 구입할 거예요 · 구입하세요","m":"購入する、買う","ex":"저는 인터넷으로 책을 자주 구입해요.","x":"私はネットでよく本を買います。","e":"漢字で「購入」＋하다。日本語の「購入する」と同じです。","t":"사다よりかたい言い方で、お店や広告、文章で見かけます。[구이파다]と発音。","parts":[["구","あがなう"],["입","入る"]],"rel":[["사다","買う"],["판매하다","販売する"],["쇼핑","ショッピング"]],"a":["b002.mp3",2315232,2688,2317920,12192],"nb":["계산","계산대","교환","교환하다","깎다","할인","세일","무료"]}],"셋째":[{"id":"T2-0689","de":"셋째","rom":"setjjae","pos":"数詞","lv":"T2","pr":"섿째","forms":"셋째 아이 · 셋째 날 · 셋째로 (thirdly)","m":"三番目；第三子","ex":"여행 셋째 날에는 가족과 바닷가에 갔어요.","x":"旅行の3日目には家族と海辺に行きました。","e":"셋「三」＋-째「〜番目」でできた言葉です。","t":"","parts":[],"rel":[["둘째","二番目"],["넷째","四番目"],["세 번째","3回目"]],"a":["b006.mp3",328320,2496,330816,13056],"nb":["친척","막내","첫째","둘째","쌍둥이","어린이","청소년","노인"]}],"계곡":[{"id":"T2-1029","de":"계곡","rom":"gyegok","pos":"名詞","lv":"T2","pr":null,"forms":"계곡이 · 계곡을","m":"渓谷、谷川","ex":"여름에 가족들과 계곡에 놀러 갔어요.","x":"夏に家族と渓谷へ遊びに行きました。","e":"漢字で「溪谷」。日本語の「渓谷（けいこく）」と同じです。韓国では夏に渓谷で水遊びをするのが定番です。","t":"","parts":[["계","谷川"],["곡","谷"]],"rel":[["산","山"],["강","川"],["물","水"]],"a":["b007.mp3",2002272,2112,2004384,