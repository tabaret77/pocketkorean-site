い"]],"a":["b053.mp3",1778688,3168,1781856,12768],"nb":["빼어나다","삼엄하다","서늘하다","선연하다","숙성하다","스산하다","시시콜콜하다","아연하다"]}],"웅숭깊다":[{"id":"T6-2188","de":"웅숭깊다","rom":"ungsunggipda","pos":"形容詞","lv":"T6","pr":"웅숭깁따","forms":"웅숭깊어요 · 웅숭깊었어요 · 웅숭깊은 (+noun)","m":"（人柄・考えが）奥深い、度量が大きい；深くくぼんでいる","ex":"할아버지의 말씀에는 웅숭깊은 뜻이 담겨 있어요.","x":"祖父の言葉には奥深い意味が込められています。","e":"깊다（深い）がもとになっています。","t":"[웅숭깁따]と発音します。","parts":[],"rel":[["깊다","深い"],["너그럽다","寛大だ"],["속","内心"]],"a":["b053.mp3",2039808,3744,2043552,13440],"nb":["요염하다","우람하다","우매하다","울창하다","유장하다","유한하다","은근하다","음울하다"]}],"순환":[{"id":"T6-2396","de":"순환","rom":"sunhwan","pos":"名詞","lv":"T6","pr":null,"forms":"순환이 · 순환을","m":"循環、サイクル、巡回","ex":"운동을 하면 혈액 순환이 좋아져요.","x":"運動をすると血液の循環がよくなります。","e":"直訳すると「輪に沿って巡る」。日本語の「循環（じゅんかん）」と同じです。","t":"","parts":[["순","したがう"],["환","わ"]],"rel":[["악순환","悪循環"],["선순환","好循環"],["순환하다","循環する"]],"a":["b054.mp3",2349408,2304,2351712,8832],"nb":["본연","불문율","상징성","서열화","역동성","영속성","위정자","윤곽"]}],"가집행":[{"id":"T6-2552","de":"가집행","rom":"gajiphaeng","pos":"名詞","lv":"T6","pr":"가지팽","forms":"가집행이 · 가집행을","m":"仮執行","ex":"판결에는 가집행을 할 수 있다는 내용이 포함되었습니다.","x":"判決には、仮執行ができるという内容が含まれていました。","e":"直訳すると「仮の執行」。判決が確定する前に執行することです。日本語の「仮執行（かりしっこう）」と同じです。","t":"[가지팽]と発音。ㅂ と ㅎ が合わさって ㅍ になるためです。","parts":[["가","仮"],["집","執る"],["행","行う"]],"rel":[["집행","執行"],["판결","判決"],["확정","確定"]],"a":["b055.mp3",2250624,3264,2253888,14304],"nb":["화이부동","화중지병","후생가외","가처분","공탁","구상권","등기부","변호권"]}],"환매":[{"id":"T6-2567","de":"환매","rom":"hwanmae","pos":"名詞","lv":"T6","pr":null,"forms":"환매가 · 환매를","m":"買い戻し","ex":"매도인은 계약에 따라 그 토지를 환매했습니다.","x":"売り手は契約に従って、その土地を買い戻しました。","e":"直訳すると「還（かえ）して買う」。売ったものを買い戻すことです。日本語では「買戻し」と言います。","t":"하다 と一緒に使います。金融では、ファンドの「解約・換金」の意味でも 환매 を使います。","parts":[["환","かえす"],["매","買う"]],"rel":[["매도","売り渡し"],["매수","買い入れ"],["환매조건부채권","買戻し条件付債券（レポ）"]],"a":["b055.mp3",2521152,2304,2523456,13728],"nb":["즉결심판","채권양도","청구권","형사보상","경기순환","공급과잉","과잉유동성","구매력"]}],"지렁이도 밟으면 꿈틀한다":[{"id":"T6-9001","de":"지렁이도 밟으면 꿈틀한다","rom":"jireongido balbeumyeon