{"부럽다":[{"id":"T2-0160","de":"부럽다","rom":"bureopda","pos":"形容詞","lv":"T2","pr":"부럽따","forms":"부러워요 · 부러웠어요 · 부러운 (+noun) (ㅂ irregular)","m":"うらやましい","ex":"제 친구는 영어를 잘해서 정말 부러워요.","x":"友達は英語が上手で、本当にうらやましいです。","e":"他の人がうらやましがる様子は-어하다を付けて表します：친구가 저를 부러워해요（友達が私をうらやましがっています）。","t":"부러워요!は気軽な「うらやましい！」です。ねたみや恋愛の嫉妬は질투하다と言います。","parts":[],"rel":[["부러워하다","うらやましがる"],["질투하다","嫉妬する"],["자랑하다","自慢する"]],"a":["b003.mp3",1581408,2496,1583904,12576],"nb":["걱정","걱정하다","놀라다","궁금하다","부끄럽다","답답하다","외롭다","그립다"]}],"계획하다":[{"id":"T2-0287","de":"계획하다","rom":"gyehoekada","pos":"動詞","lv":"T2","pr":"계회카다","forms":"계획해요 · 계획했어요 · 계획할 거예요 · 계획하세요","m":"計画する","ex":"우리는 다음 달 여행을 같이 계획하고 있어요.","x":"私たちは来月の旅行を一緒に計画しています。","e":"漢字で「計劃」。日本語の「計画（けいかく）する」と同じです（劃は画の旧字体です）。","t":"名詞を使うときは계획을 세우다「計画を立てる」と言います。日本語と同じく「立てる」ですね。","parts":[["계","はかる"],["획","区切る"]],"rel":[["계획","計画"],["일정","日程"],["준비하다","準備する"]],"a":["b004.mp3",499680,2976,502656,11616],"nb":["안내하다","지도","가이드","일정","예약","취소","취소하다","숙소"]}],"계속하다":[{"id":"T2-0862","de":"계속하다","rom":"gyesokada","pos":"動詞","lv":"T2","pr":"계소카다","forms":"계속해요 · 계속했어요 · 계속할 거예요 · 계속하세요","m":"続ける","ex":"힘들어도 저는 운동을 계속할 거예요.","x":"大変でも、私は運動を続けるつもりです。","e":"漢字で「繼續」。日本語の「継続（けいぞく）」と同じ漢字ですが、韓国語の계속하다は「続ける」と同じくらい日常的に使います。","t":"계속だけで副詞としても使えます：계속 비가 와요＝ずっと雨が降っています。[계소카다]と発音します。","parts":[["계","継ぐ"],["속","続く"]],"rel":[["계속","ずっと、引き続き"],["그만두다","やめる"],["멈추다","止まる、止める"]],"a":["b006.mp3",2663520,3168,2666688,11520],"nb":["흐르다","결정하다","경험","경험하다","고생하다","노력","노력하다","늦잠"]}],"노력":[{"id":"T2-0864","de":"노력","rom":"noryeok","pos":"名詞","lv":"T2","pr":null,"forms":"노력이 · 노력을","m":"努力","ex":"좋은 결과를 얻으려면 노력이 필요해요.","x":"いい結果を得るには努力が必要です。","e":"漢字で「努力」。日本語の「努力（どりょく）」と同じです。","t":"","parts":[["노","努める"],["력","力"]],"rel":[["노력하다","努力する"],["열심히","一生懸命"],["성공","成功"]],"a":["b006.mp3",2693280,1728,2695008,11040],"nb":["경험","경험하다","계속하다","고생하다","노력하다","늦잠","등록하다","목욕하다"]}],"상관없다":[{"id":"T2-0926","de":"상관없다","rom":"sanggwaneopda","pos":"形容詞","lv":"T2","pr":"상과넙따","forms":"상관없어요 · 상관없었어요 · 상관없는 (+noun)","m":"かまわない、関係ない；気にしない","ex":"저는 아무 음식이나 다 상관없어요.","x":"私はどんな食べ物でも大丈夫です。","e":"상관（関係）＋없다（ない）＝「関係ない」。漢字で「相關」ですが、日本語の「相関」とは使い方が違い、「関係ない、かまわない」にあたります。","t":"[상과넙따]と発音します。好みを聞かれたときの便利な返事：저는 상관없어요（私はどちらでもかまいません）。","parts":[["상","互い"],["관","関わる"]],"rel":[["괜찮다","大丈夫だ"],["관계없다","関係ない"],["상관","関係、関わり"]],"a":["b007.mp3",640512,3168,643680,9792],"nb":["튼튼하다","편리하다","급하다","부족하다","가장","갑자기","거의","결국"]}],"예정":[{"id":"T2-1095","de":"예정","rom":"yejeong","pos":"名詞","lv":"T2","pr":null,"forms":"예정이 · 예정을","m":"予定","ex":"저는 다음 주에 부산에 갈 예정이에요.","x":"私は来週、釜山に行く予定です。","e":"漢字で「豫定」。日本語の「予定（よてい）」と同じです。","t":"-(으)ㄹ 예정이에요で「〜する予定です」と言います。","parts":[["예","予め"],["정","定める"]],"rel":[["계획","計画"],["일정","日程"],["예약","予約"]],"a":["b007.mp3",2871840,2784,2874624,12096],"nb":["얘기","언어","연세","예","오해","우표","엽서","운"]}],"회복하다":[{"id":"T3-0153","de":"회복하다","rom":"hoebokada","pos":"動詞","lv":"T3","pr":"회보카다","forms":"회복해요 · 회복했어요 · 회복할 거예요 · 회복하세요","m":"回復する、取り戻す","ex":"충분히 쉬고 나서 건강을 회복했어요.","x":"十分に休んだら、健康を取り戻しました。","e":"漢字で「回復」＋하다。日本語の「回復（かいふく）する」と同じです。","t":"健康以外にも使います：신뢰를 회복하다「信頼を回復する」。","parts":[["회","回る"],["복","再び"]],"rel":[["회복","回復"],["낫다","治る"],["퇴원하다","退院する"]],"a":["b008.mp3",2447424,3264,2450688,9696],"nb":["반창고","부작용","효과","회복","영양","살을 빼다","스트레스","피로"]}],"존경하다":[{"id":"T3-0266","de":"존경하다","rom":"jongyeonghada","pos":"動詞","lv":"T3","pr":null,"forms":"존경해요 · 존경했어요 · 존경할 거예요 · 존경하세요","m":"尊敬する","ex":"제가 가장 존경하는 사람은 우리 어머니예요.","x":"私がいちばん尊敬する人は母です。","e":"漢字で「尊敬」＋하다。日本語の「尊敬（そんけい）する」と同じです。","t":"존경하다は人を見上げて敬うこと、존중하다は誰であれその権利・意見・選択を尊重することです。","parts":[["존","尊ぶ"],["경","敬う"]],"rel":[["존경","尊敬"],["존중하다","尊重する"],["선배","先輩"]],"a":["b009.mp3",1104672,3360,1108032,12288],"nb":["전통","예절","예의 바르다","존경","존중","세배","제사","한옥"]}],"주장하다":[{"id":"T3-0608","de":"주장하다","rom":"jujanghada","pos":"動詞","lv":"T3","pr":null,"forms":"주장해요 · 주장했어요 · 주장할 거예요 · 주장하세요","m":"主張する、言い張る","ex":"그는 자신이 옳다고 계속 주장했어요.","x":"彼は自分が正しいと言い張り続けました。","e":"漢字で「主張」＋-하다。日本語の「主張する」と同じです。","t":"ふつう-다고と一緒に使います：옳다고 주장하다（正しいと主張する）。","parts":[["주"