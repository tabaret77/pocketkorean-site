」，唔好搞錯。","parts":[["혹","某"],["자","者"]],"rel":[["어떤 사람","某啲人"],["누군가","某人"],["일부","一部分"]],"a":["b051.mp3",1171680,2880,1174560,13056],"nb":["필경","필시","한낱","한사코","홀연히","흡사","극구","다분히"]}],"가부장제":[{"id":"T6-1824","de":"가부장제","rom":"gabujangje","pos":"名詞","lv":"T6","pr":null,"forms":"가부장제가 · 가부장제를","m":"父權制、家長制","ex":"가부장제의 영향은 아직도 명절 문화에 남아 있어요.","x":"父權制嘅影響至今仍然殘留喺節日文化入面。","e":"字面意思係「家庭以父親為首嘅制度」。漢字係「家父長制」。","t":"","parts":[["가","家"],["부","父"],["장","長"],["제","制度"]],"rel":[["가부장적","父權"],["남존여비","男尊女卑"],["성평등","性別平等"],["페미니즘","女性主義"]],"a":["b051.mp3",1742304,3456,1745760,15840],"nb":["학벌주의","연고주의","지연","페미니즘","남존여비","유리천장","경력단절","일과 삶의 균형"]}],"경기순환":[{"id":"T6-2568","de":"경기순환","rom":"gyeonggisunhwan","pos":"名詞","lv":"T6","pr":null,"forms":"경기순환이 · 경기순환을","m":"經濟週期、景氣循環","ex":"경기순환에 따라 호황과 불황이 반복됩니다.","x":"經濟繁榮同衰退會隨住經濟週期重複出現。","e":"漢字係「景氣循環」，即係經濟週期。","t":"","parts":[["경","景"],["기","氣"],["순","循"],["환","環"]],"rel":[["경기","經濟、景氣"],["호황","繁榮"],["불황","衰退"]],"a":["b055.mp3",2537184,3552,2540736,10368],"nb":["채권양도","청구권","형사보상","환매","공급과잉","과잉유동성","구매력","금본위제"]}]}