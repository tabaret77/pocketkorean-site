":"T4","pr":null,"forms":"풀려요 · 풀렸어요 · 풀릴 거예요 · 풀린 (+noun)","m":"鬆開、解開；（問題）解決；（疲勞、天氣、怒氣）緩和","ex":"따뜻한 물에 목욕하니까 피로가 풀렸어요.","x":"泡了個熱水澡，疲勞都消除了。","e":"풀다「解開、解決」的被動形。","t":"用法很多：날씨가 풀리다（天氣回暖）、화가 풀리다（消氣）、일이 잘 풀리다（事情順利）。","parts":[],"rel":[["풀다","解開、解決"],["해결되다","被解決"],["피로","疲勞"]],"a":["b025.mp3",548736,2688,551424,11424],"nb":["튀어나오다","퍼뜨리다","펼치다","품다","허물다","헐다","헤아리다","훑어보다"]}],"연대감":[{"id":"T5-0575","de":"연대감","rom":"yeondaegam","pos":"名詞","lv":"T5","pr":null,"forms":"연대감이 · 연대감을","m":"團結感、連帶感","ex":"함께 어려움을 이겨내면서 연대감이 생겼어요.","x":"在一起克服困難的過程中，產生了團結感。","e":"漢字是「連帶感」，就是團結的感覺；-감 就是「-感」：소속감（歸屬感）、책임감（責任感）。","t":"","parts":[["연","連"],["대","帶子"],["감","感覺"]],"rel":[["연대","團結"],["소속감","歸屬感"],["유대감","連結感、情誼"],["공동체","共同體"]],"a":["b030.mp3",2488032,3744,2491776,12576],"nb":["낙하산","청탁","공중도덕","비영리","공존","포용","관용","교육과정"]}],"권위자":[{"id":"T5-0591","de":"권위자","rom":"gwonwija","pos":"名詞","lv":"T5","pr":"궈뉘자","forms":"권위자가 · 권위자를","m":"權威、權威人士","ex":"그는 뇌 과학 분야의 최고 권위자예요.","x":"他是腦科學領域的頂尖權威。","e":"漢字是「權威者」，就是權威人士。","t":"","parts":[["권","權力"],["위","威"],["자","者"]],"rel":[["권위","權威"],["전문가","專家"],["석학","大學者"],["대가","大師"]],"a":["b030.mp3",2736960,3456,2740416,12384],"nb":["은사","낙제","학자금","석학","전문성","식견","학식","지식인"]}],"획일적":[{"id":"T5-1142","de":"획일적","rom":"hoegiljeok","pos":"冠形詞","lv":"T5","pr":"회길쩍","forms":"획일적인 (+noun) · 획일적이에요 · 획일적으로","m":"劃一的、一刀切的、千篇一律的","ex":"획일적인 교육은 학생들의 창의력을 떨어뜨릴 수 있습니다.","x":"一刀切的教育可能會削弱學生的創造力。","e":"字面意思是「劃一」——全部變得一模一樣。","t":"讀作 [회길쩍]；通常帶批評意味，例如 획일적인 교육 或 획일적인 기준。中文「劃一」偏中性，韓文 획일적 多半是貶義。","parts":[["획","劃"],["일","一"],["적","……的"]],"rel":[["개성적","有個性的"],["다양하다","多樣"],["천편일률적","千篇一律的"]],"a":["b033.mp3",2810016,2592,2812608,15552],"nb":["방어적","순종적","반항적","개성적","천편일률적","도전적","안일하다","나약하다"]}],"착착":[{"id":"T5-1321","de":"착착","rom":"chakchak","pos":"副詞","lv":"T5","pr":null,"forms":"착착 진행되다 · 착착 붙다","m":"順利地、有條不紊地；服貼地","ex":"결혼 준비가 계획대로 착착 진행되고 있어요.","x":"婚禮的準備按照計畫順利進行中。","e":"擬態詞：想像東西一件件喀嚓卡進位置。","t":"別搞混：착착 是計畫順利推進；척척 是人做事俐落。","parts":[],"rel":[["척척","俐落地"],["순조롭게","