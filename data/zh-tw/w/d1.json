":"密、密密麻麻、緊密","ex":"이 그물은 아주 촘촘해서 작은 물고기도 잡을 수 있어요.","x":"這張網很密，連小魚都撈得到。","e":"重疊的音節讓人聯想到許多細小的東西緊密排在一起。","t":"","parts":[],"rel":[["빽빽하다","密密麻麻"],["듬성듬성","稀稀疏疏"],["촘촘히","密密地"]],"a":["b025.mp3",2044320,3552,2047872,15552],"nb":["짙다","착실하다","참신하다","초라하다","치열하다","친밀하다","타당하다","탁월하다"]}],"모순":[{"id":"T4-1975","de":"모순","rom":"mosun","pos":"名詞","lv":"T4","pr":null,"forms":"모순이 · 모순을","m":"矛盾","ex":"그의 말과 행동에는 모순이 있어요.","x":"他的言行之間有矛盾。","e":"漢字是「矛盾」，出自自相矛盾的故事，和中文一樣。","t":"","parts":[["모","矛"],["순","盾"]],"rel":[["모순되다","矛盾"],["일관성","一致性"],["논리","邏輯"]],"a":["b026.mp3",1859040,2304,1861344,10368],"nb":["동질감","뒷받침","맥락","명분","문맥","미덕","반론","발상"]}],"줄다리기":[{"id":"T4-9015","de":"줄다리기","rom":"juldarigi","pos":"名詞","lv":"T4","pr":null,"forms":"줄다리기가 · 줄다리기를","m":"拔河","ex":"운동회 줄다리기에서 우리 반이 이겼어요.","x":"運動會的拔河比賽我們班贏了。","e":"줄「繩子」＋다리기，來自古語中「拉」的動詞（現在說 당기다）。","t":"學校運動會（운동회）的必備項目。也可以比喻雙方的角力，例如談判時的拉鋸。","parts":[],"rel":[["줄","繩子、線"],["당기다","拉"],["이기다","贏"]],"a":["b057.mp3",590112,2808,592920,8280],"nb":["조선","연날리기","공기놀이","씨름","돌잡이","수험표","엿","면회"]}],"리얼리티":[{"id":"T4-9046","de":"리얼리티","rom":"rieolliti","pos":"名詞","lv":"T4","pr":null,"forms":"리얼리티가 · 리얼리티를","m":"實境節目、實境秀；真實感","ex":"요즘은 연애 리얼리티 프로그램이 인기가 많아요.","x":"最近戀愛實境節目很受歡迎。","e":"來自英文 \"reality\"。","t":"通常後面接 프로그램 或 쇼。관찰 예능「觀察綜藝」是相關類型，記錄藝人的日常生活。單獨使用時常指「真實感」：리얼리티가 떨어지다 = 不夠真實、不太寫實。","parts":[],"rel":[["예능","綜藝節目"],["관찰","觀察"],["몰래카메라","隱藏攝影機整人"]],"a":["b057.mp3",1433736,2664,1436400,10656],"nb":["로코","사극","스릴러","주말 드라마","몰래카메라","오티티","정주행","몰아보다"]}],"콩닥콩닥":[{"id":"T4-9141","de":"콩닥콩닥","rom":"kongdakkongdak","pos":"副詞","lv":"T4","pr":null,"forms":"가슴이 콩닥콩닥 뛰다 · 콩닥거리다","m":"撲通撲通（心動）、小鹿亂撞","ex":"좋아하는 사람을 보니까 가슴이 콩닥콩닥 뛰어요.","x":"看到喜歡的人，心就撲通撲通地跳。","e":"原本也是用臼搗穀物的聲音；現在主要用來形容心跳加快。","t":"動詞是 콩닥거리다。聽起來比 두근두근 更輕快可愛，常用在暗戀時，有點像我們說「小鹿亂撞」。","parts":[],"rel":[["두근두근","怦怦跳"],["두근거리다","（心）怦怦跳"],["설레다","心動、興奮"]],"a":["b062.mp3",805536,2664,808200,11880],"nb":["비틀거리다","오물오물","벌컥벌컥","쩝쩝","오싹오싹","지끈지끈","꾸벅꾸벅","폭신폭신"]}],"땡땡이를 치다":[{"id":"T4-9170","de":"땡땡