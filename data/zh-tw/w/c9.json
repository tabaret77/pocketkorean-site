":[["혼","混合"],["재","存在"]],"rel":[["공존하다","共存"],["뒤섞이다","混雜在一起"],["혼합","混合"]],"a":["b050.mp3",537792,2784,540576,12768],"nb":["함양하다","해이하다","호도하다","혹평하다","회고하다","회귀하다","훼손하다","희석하다"]}],"도도하다":[{"id":"T6-1660","de":"도도하다","rom":"dodohada","pos":"形容詞","lv":"T6","pr":null,"forms":"도도해요 · 도도했어요 · 도도한 (+noun)","m":"高傲、驕傲、自命清高","ex":"그녀는 도도한 표정으로 고개를 돌렸어요.","x":"她一臉高傲地把頭轉開。","e":"注意同音詞：另一個 도도하다（滔滔）是「滔滔不絕、浩浩蕩蕩」（形容河流或歷史潮流）。","t":"形容有型、冷傲的女生時帶點讚美意味，比較接近「高冷」，而不只是「沒禮貌」。","parts":[],"rel":[["거만하다","傲慢"],["오만하다","高傲"],["겸손하다","謙虛"]],"a":["b050.mp3",2044800,3168,2047968,12096],"nb":["난해하다","녹록하다","늠름하다","다분하다","돈독하다","막강하다","명료하다","명철하다"]}],"희한하다":[{"id":"T6-1732","de":"희한하다","rom":"huihanhada","pos":"形容詞","lv":"T6","pr":"히한하다","forms":"희한해요 · 희한했어요 · 희한한 (+noun)","m":"奇怪、古怪；罕見、稀奇","ex":"어젯밤에 정말 희한한 꿈을 꿨어요.","x":"我昨晚做了一個很奇怪的夢。","e":"字面意思是「稀而罕」，也就是很少見。漢字是「稀罕」，韓文則是「古怪」。","t":"常見錯字：희안하다 是錯的，正確寫法是 희한하다。中文「誰稀罕」的「稀罕」是在乎，和韓文意思不同。","parts":[["희","稀"],["한","罕"]],"rel":[["이상하다","奇怪"],["신기하다","神奇"],["묘하다","奇妙、微妙"]],"a":["b051.mp3",271392,2784,274176,10848],"nb":["황망하다","후덕하다","흉흉하다","희박하다","가당찮다","고단하다","고약하다","구차하다"]}],"능소능대":[{"id":"T6-2449","de":"능소능대","rom":"neungsoneungdae","pos":"名詞","lv":"T6","pr":null,"forms":"능소능대가 · 능소능대를","m":"能大能小、多才多藝","ex":"그는 능소능대해서 어떤 일을 맡겨도 잘해요.","x":"他能大能小，交給他什麼事都做得很好。","e":"漢字是「能小能大」，字面意思是「小事能做、大事也能做」。","t":"可以當 하다 形容詞用：능소능대하다。","parts":[["능","能"],["소","小"],["능","能"],["대","大"]],"rel":[["다재다능","多才多藝"],["유능하다","有能力"],["만능","萬能"]],"a":["b055.mp3",379008,3936,382944,13344],"nb":["남가일몽","낭중지추","노마지지","누란지세","다기망양","당동벌이","대경실색","도원결의"]}]}