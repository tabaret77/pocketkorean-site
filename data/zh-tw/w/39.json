{"우리":[{"id":"T1-024","de":"우리","rom":"uri","pos":"代名詞","lv":"T1","pr":null,"forms":"우리가 · 우리를 · our: 우리 (우리 집)","m":"我們；我們的、我的","ex":"우리 같이 점심 먹어요.","x":"我們一起吃午餐吧。","e":"","t":"韓國人常用 우리 代替「我的」：우리 엄마（我媽媽）、우리 집（我家）。這和臺灣人說「我們家」、「我們老師」的習慣很像。","parts":[],"rel":[["저희","我們（謙稱）"],["나","我"],["우리나라","我國（韓國）"]],"a":["b000.mp3",304608,1824,306432,6048],"nb":["아니요","저","나","저희","너","이것","그것","저것"]}],"세계":[{"id":"T1-228","de":"세계","rom":"segye","pos":"名詞","lv":"T1","pr":null,"forms":"세계가 · 세계를 · 세계 여행 (world trip)","m":"世界","ex":"세계 여러 나라를 여행하고 싶어요.","x":"我想去世界各國旅行。","e":"漢字「世界」，和中文一樣。세계 지도 ＝ 世界地圖。","t":"","parts":[["세","世"],["계","界"]],"rel":[["나라","國家"],["외국","外國"],["지도","地圖"]],"a":["b000.mp3",2311968,2592,2314560,9120],"nb":["박물관","아파트","건물","외국","앞","뒤","옆","위"]}],"시험":[{"id":"T1-364","de":"시험","rom":"siheom","pos":"名詞","lv":"T1","pr":null,"forms":"시험이 · 시험을","m":"考試、測驗","ex":"다음 주에 한국어 시험이 있어요.","x":"我下週有韓語考試。","e":"漢字「試驗」，也就是中文的「考試」。","t":"「考試」是 시험을 보다（字面「看考試」）。注意：中文的「試驗」多半指實驗，韓語 시험 主要是考試。","parts":[["시","試"],["험","驗"]],"rel":[["시험을 보다","考試"],["공부하다","讀書"],["문제","題目、問題"]],"a":["b001.mp3",811968,1920,813888,7392],"nb":["신호등","다리","공부","숙제","수업","책","공책","연필"]}],"이유":[{"id":"T1-473","de":"이유","rom":"iyu","pos":"名詞","lv":"T1","pr":null,"forms":"이유가 · 이유를","m":"理由、原因","ex":"늦은 이유가 뭐예요?","x":"你遲到的理由是什麼？","e":"漢字是「理由」，和中文一樣 — 回答 왜？（為什麼？）就要說 이유。","t":"","parts":[["이","道理"],["유","緣由"]],"rel":[["왜","為什麼"],["그래서","所以"],["때문에","因為"]],"a":["b001.mp3",1963104,2208,1965312,4608],"nb":["사랑","생각","이야기","소리","계획","약속","연락","생활"]}],"출발하다":[{"id":"T1-604","de":"출발하다","rom":"chulbalhada","pos":"動詞","lv":"T1","pr":null,"forms":"출발해요 · 출발했어요 · 출발할 거예요 · 출발하세요","m":"出發","ex":"기차가 열 시에 서울역에서 출발해요.","x":"火車十點從首爾站出發。","e":"漢字是「出發」，和中文一樣；相反：도착하다（抵達）。","t":"","parts":[["출","出"],["발","出發"]],"rel":[["출발","出發（名詞）"],["도착하다","抵達"],["떠나다","離開"]],"a":["b002.mp3",487104,3648,490752,11328],"nb":["기억하다","잊어버리다","연습하다","이해하다","도착하다","운전하다","이사하다","초대하다"]}],"너무":[{"id":"T1-711","de":"너무","rom":"neomu","pos":"副詞",