{"차":[{"id":"T1-277","de":"차","rom":"cha","pos":"名詞","lv":"T1","pr":null,"forms":"차가 · 차를","m":"茶","ex":"따뜻한 차 한 잔 드세요.","x":"請喝一杯熱茶。","e":"漢字「茶」。","t":"차 也是「車」（車），看上下文就知道。茶名：녹차（綠茶）、홍차（紅茶）、보리차（大麥茶）。","parts":[],"rel":[["녹차","綠茶"],["커피","咖啡"],["마시다","喝"]],"a":["b000.mp3",2788608,1920,2790528,5760],"nb":["양파","물","우유","커피","주스","맥주","술","소주"]},{"id":"T1-348","de":"차","rom":"cha","pos":"名詞","lv":"T1","pr":null,"forms":"차가 · 차를","m":"車、車輛","ex":"아버지는 차로 출근하세요.","x":"我爸爸開車上班。","e":"漢字「車」。","t":"同音詞：차 也是茶（茶）。看上下文就能分辨：차를 마셔요（喝茶）和 차를 타요（坐車）。","parts":[["차","車"]],"rel":[["자동차","汽車"],["운전하다","開車"],["타다","搭乘"]],"a":["b001.mp3",626112,2112,628224,6720],"nb":["선물","카드","현금","영수증","자동차","버스","지하철","기차"]}],"원피스":[{"id":"T1-328","de":"원피스","rom":"wonpiseu","pos":"名詞","lv":"T1","pr":null,"forms":"원피스가 · 원피스를","m":"洋裝、連身裙","ex":"친구 결혼식에 파란 원피스를 입고 갔어요.","x":"我穿了一件藍色洋裝去參加朋友的婚禮。","e":"來自英文 \"one-piece\"。","t":"韓式英文：원피스 是女生的連身洋裝，不是連身泳衣。","parts":[],"rel":[["치마","裙子"],["옷","衣服"],["입다","穿"]],"a":["b001.mp3",395328,3552,398880,11136],"nb":["바지","치마","셔츠","티셔츠","코트","양말","신발","구두"]}],"무릎":[{"id":"T2-0097","de":"무릎","rom":"mureup","pos":"名詞","lv":"T2","pr":"무릅","forms":"무릎이 · 무릎을","m":"膝蓋；大腿上（坐時）","ex":"어제 등산을 많이 해서 무릎이 아파요.","x":"昨天爬了很多山，膝蓋好痛。","e":"也指坐著時的大腿上方：무릎에 앉다 ＝ 坐在別人腿上。","t":"單獨唸像 [무릅]，但在母音前 ㅍ 會出現：무릎이 [무르피]。","parts":[],"rel":[["다리","腿"],["발","腳"],["허리","腰"],["무릎을 꿇다","跪下"]],"a":["b003.mp3",659424,1536,660960,8928],"nb":["멀리","킬로미터","가슴","등","발가락","이","혀","입술"]}],"틀리다":[{"id":"T2-0442","de":"틀리다","rom":"teullida","pos":"動詞","lv":"T2","pr":null,"forms":"틀려요 · 틀렸어요 · 틀릴 거예요 · 틀린 (+noun)","m":"錯、弄錯；答錯","ex":"시험에서 두 문제를 틀렸어요.","x":"考試我錯了兩題。","e":"","t":"很多韓國人會用 틀리다 表示「不一樣」，但標準韓文表示「不同」要用 다르다。","parts":[],"rel":[["맞다","對、正確"],["맞히다","答對"],["실수","失誤"]],"a":["b004.mp3",2642208,2496,2644704,8544],"nb":["설명하다","복습하다","예습하다","외우다","맞히다","문법","발음","읽기"]}],"삶다":[{"id":"T2-0589","de":"삶다","rom":"samda","pos":"動詞","lv":"T2","pr":"삼따","forms":"삶아요 · 삶았어요 · 삶을 거예요 · 삶으세요","m":"（用水）煮、燙","ex":"계란을 냄비에 