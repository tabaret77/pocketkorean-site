"pr":null,"forms":"취지가 · 취지를","m":"宗旨、用意、目的","ex":"이 행사의 취지는 어려운 이웃을 돕는 것입니다.","x":"這個活動的宗旨是幫助有困難的鄰居。","e":"字面意思是「旨趣和意旨」：背後想表達的重點。漢字是「趣旨」。","t":"","parts":[["취","旨趣"],["지","意旨"]],"rel":[["목적","目的"],["의도","意圖"],["의미","意義"]],"a":["b027.mp3",31776,2400,34176,13056],"nb":["지표","차원","초점","추상적","타당성","토대","특색","특성"]}],"숙박비":[{"id":"T4-2138","de":"숙박비","rom":"sukbakbi","pos":"名詞","lv":"T4","pr":"숙빡삐","forms":"숙박비가 · 숙박비를","m":"住宿費","ex":"성수기에는 숙박비가 두 배로 올라요.","x":"旺季的時候住宿費會漲成兩倍。","e":"字面意思是「過夜的費用」。漢字是「宿泊費」。","t":"晚數用 박 來算：2박 3일 就是「三天兩夜」。","parts":[["숙","住宿"],["박","停留"],["비","費用"]],"rel":[["숙소","住處"],["교통비","交通費"],["1박 2일","兩天一夜"]],"a":["b027.mp3",1353216,3456,1356672,10848],"nb":["연착","결항","탑승권","수속","성수기","비수기","배낭여행","여행객"]}],"솔솔":[{"id":"T4-9128","de":"솔솔","rom":"solsol","pos":"副詞","lv":"T4","pr":null,"forms":"솔솔 + 불다 (바람) / 나다 (냄새) / 오다 (잠)","m":"（微風）徐徐吹來；（香味）陣陣飄來","ex":"창문을 여니까 시원한 바람이 솔솔 불어요.","x":"一打開窗戶，涼風就徐徐吹進來。","e":"의태어（擬態詞），形容輕盈的東西柔和而持續地流出來。陰性母音版本 술술 現在多半指「順利、流暢」。","t":"也用於氣味和睏意：고소한 냄새가 솔솔 나요「陣陣香氣飄來」；잠이 솔솔 와요「開始想睡了」。","parts":[],"rel":[["바람","風、微風"],["냄새","氣味"],["술술","順利、流暢"]],"a":["b062.mp3",650448,1944,652392,10800],"nb":["탕","째깍째깍","쨍그랑","보슬보슬","우르릉","살랑살랑","철썩","성큼성큼"]}],"뒤뚱뒤뚱":[{"id":"T4-9133","de":"뒤뚱뒤뚱","rom":"dwittungdwittung","pos":"副詞","lv":"T4","pr":null,"forms":"뒤뚱뒤뚱 + 걷다 / 걸어가다 · 뒤뚱거리다","m":"搖搖擺擺、一搖一擺地走","ex":"펭귄들이 얼음 위를 뒤뚱뒤뚱 걸어가요.","x":"企鵝在冰上搖搖擺擺地走。","e":"의태어（擬態詞），形容笨重的身體走路時左右搖晃。","t":"動詞 뒤뚱거리다 很常用：오리가 뒤뚱거리며 걸어요。經典用法是形容鴨子、企鵝和學步的幼兒。","parts":[],"rel":[["걷다","走路"],["아장아장","蹣跚學步"],["비틀비틀","踉踉蹌蹌"]],"a":["b062.mp3",714528,4248,718776,8856],"nb":["우르릉","살랑살랑","철썩","성큼성큼","엉금엉금","비틀비틀","아장아장","비틀거리다"]}],"아장아장":[{"id":"T4-9136","de":"아장아장","rom":"ajangajang","pos":"副詞","lv":"T4","pr":null,"forms":"아장아장 + 걷다 / 걸어오다","m":"蹣跚學步、搖搖晃晃（小孩走路）","ex":"아기가 엄마한테 아장아장 걸어가요.","x":"寶寶搖搖晃晃地走向媽媽。","e":"의태어（擬態詞），形容小孩踩著小碎步、小心翼翼地走路。","t":"聽起來可愛又充滿疼愛，所以不用在大人身上；大人走不穩用 비틀비틀 比較合適。","parts":[],"rel":[["아기","寶寶"],["걸음마를 떼다","學走路"],["뒤뚱뒤뚱","搖搖擺擺"]],"a":["b062.mp3",752904,2448,75535