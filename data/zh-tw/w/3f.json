{"잘 먹었습니다":[{"id":"T1-012","de":"잘 먹었습니다","rom":"jal meogeotseumnida","pos":"慣用語","lv":"T1","pr":"잘 머걷씀니다","forms":"polite: 잘 먹었어요 · casual: 잘 먹었어","m":"謝謝招待、我吃飽了（飯後說）","ex":"할머니, 정말 맛있게 잘 먹었습니다.","x":"奶奶，真的很好吃，謝謝您。","e":"字面意思是「我吃得很好」，是 잘 먹겠습니다 的過去式，吃完後說。","t":"吃完後對主人或請客的人說，離開餐廳時也會對店員說。","parts":[],"rel":[["잘 먹겠습니다","我開動了（飯前）"],["맛있다","好吃"],["배부르다","飽"]],"a":["b000.mp3",160128,4800,164928,10368],"nb":["괜찮아요","처음 뵙겠습니다","만나서 반갑습니다","잘 먹겠습니다","어서 오세요","여보세요","실례합니다","축하합니다"]}],"지하철":[{"id":"T1-351","de":"지하철","rom":"jihacheol","pos":"名詞","lv":"T1","pr":null,"forms":"지하철이 · 지하철을","m":"地鐵、捷運","ex":"서울에서는 지하철이 아주 편해요.","x":"在首爾搭地鐵非常方便。","e":"漢字「地下鐵」，也就是「地鐵」，相當於臺灣的捷運。지하 單獨使用指地下室或地下。","t":"","parts":[["지","地"],["하","下"],["철","鐵"]],"rel":[["지하철역","地鐵站"],["타다","搭乘"],["갈아타다","轉乘"]],"a":["b001.mp3",662400,2880,665280,9120],"nb":["영수증","차","자동차","버스","기차","택시","비행기","배"]}],"약속":[{"id":"T1-475","de":"약속","rom":"yaksok","pos":"名詞","lv":"T1","pr":"약쏙","forms":"약속이 · 약속을","m":"約定、承諾；約會、和人有約","ex":"오늘 저녁에 친구하고 약속이 있어요.","x":"今天晚上我和朋友有約。","e":"漢字是「約束」。","t":"약속 包含「承諾」和「和人有約」兩個意思。讀作 [약쏙]。假朋友：不是中文「約束」（限制）的意思。","parts":[["약","約定"],["속","綁"]],"rel":[["약속하다","承諾、答應"],["만나다","見面"],["시간","時間"]],"a":["b001.mp3",1979232,2400,1981632,12288],"nb":["이야기","소리","이유","계획","연락","생활","모양","색"]}],"아니다":[{"id":"T1-523","de":"아니다","rom":"anida","pos":"形容詞","lv":"T1","pr":null,"forms":"아니에요 · 아니었어요 · 아닐 거예요 · 아닌 (+noun)","m":"不是（否定繫詞）","ex":"저는 중국 사람이 아니에요.","x":"我不是中國人。","e":"이다 的否定：학생이 아니에요 = 我不是學生。아니요 = 不是。","t":"名詞要加 이/가：학생이 아니에요。單說 아니에요 也是「不會、不客氣」的意思。","parts":[],"rel":[["이다","是"],["아니요","不是（回答）"],["안","不"]],"a":["b001.mp3",2453184,3456,2456640,7584],"nb":["살다","있다","없다","이다","하다","되다","알다","모르다"]}],"행복하다":[{"id":"T1-673","de":"행복하다","rom":"haengbokada","pos":"形容詞","lv":"T1","pr":"행보카다","forms":"행복해요 · 행복했어요 · 행복한 (+noun)","m":"幸福","ex":"가족과 함께 있으면 행복해요.","x":"和家人在一起的時候我很幸福。","e":"漢字是「幸福」，和中文一樣 + 하다。","t":"讀作 [행보카다]。행복하세요！= 「祝你幸福！」— 常見的溫暖祝福。","parts":[["행","幸運"],["복","福氣"]],"rel":[["행복","幸福（名詞）"],["