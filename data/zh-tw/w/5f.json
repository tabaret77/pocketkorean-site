ada","pos":"動詞","lv":"T4","pr":null,"forms":"체해요 · 체했어요 · 체할 거예요 · 체한 것 같아요","m":"消化不良、積食（食物卡住的感覺）","ex":"점심을 급하게 먹었더니 체한 것 같아요.","x":"午餐吃太急，好像消化不良了。","e":"滯「停滯、堵塞」＋하다：食物下不去。","t":"韓國非常常見的不適：吃太快後覺得食物「卡住」的沉重感。大家會吃 소화제，有些人還會用扎指尖放血的民間療法（손을 따다）。","parts":[["체","停滯、堵塞"]],"rel":[["소화제","消化藥"],["소화","消化"],["메스껍다","反胃"]],"a":["b063.mp3",2967264,1800,2969064,9432],"nb":["생리","생리대","숙취","탈모","멀미"]}],"독자층":[{"id":"T5-0200","de":"독자층","rom":"dokjacheung","pos":"名詞","lv":"T5","pr":"독짜층","forms":"독자층이 · 독자층을","m":"讀者群","ex":"이 잡지는 주로 이십 대가 독자층이에요.","x":"這本雜誌的讀者群主要是二十幾歲的人。","e":"字面意思是「讀者的階層」；-층 表示社會族群：젊은 층、고객층。漢字是「讀者層」。","t":"","parts":[["독","讀"],["자","人"],["층","層"]],"rel":[["독자","讀者"],["구독","訂閱"],["시청자","觀眾"]],"a":["b028.mp3",2323584,3264,2326848,11808],"nb":["논설","논설위원","칼럼니스트","투고","발행","간행물","중계","편집"]}],"착각":[{"id":"T5-0311","de":"착각","rom":"chakgak","pos":"名詞","lv":"T5","pr":"착깍","forms":"착각이 · 착각을","m":"錯覺、誤以為、搞錯","ex":"오늘이 일요일인 줄 알고 잠깐 착각했어요.","x":"我以為今天是星期天，一時搞錯了。","e":"漢字是「錯覺」。韓文多半是「搞錯、誤以為」。","t":"句型：-(으)ㄴ/는 줄 착각하다「誤以為……」。","parts":[["착","錯"],["각","覺"]],"rel":[["오해","誤會"],["착각하다","搞錯"],["환상","幻想"]],"a":["b029.mp3",1091520,2592,1094112,14784],"nb":["선망","동경","감수성","인지","망상","편향","분별력","적응력"]}],"정복":[{"id":"T5-0352","de":"정복","rom":"jeongbok","pos":"名詞","lv":"T5","pr":null,"forms":"정복이 · 정복을","m":"征服","ex":"알렉산더 대왕은 넓은 지역을 정복했어요.","x":"亞歷山大大帝征服了廣大的地區。","e":"漢字是「征服」，和中文一樣。","t":"","parts":[["정","征"],["복","服"]],"rel":[["정복자","征服者"],["침략","侵略"],["지배","統治"]],"a":["b029.mp3",1768896,2208,1771104,12960],"nb":["분단","분단국가","침략","침입","식민지","독립운동","독립운동가","광복"]}],"삭막하다":[{"id":"T5-1048","de":"삭막하다","rom":"sangmakada","pos":"形容詞","lv":"T5","pr":"상마카다","forms":"삭막해요 · 삭막했어요 · 삭막한 (+noun)","m":"荒涼、蕭索；冷漠、沒人情味（氣氛）","ex":"도시 생활이 가끔 삭막하게 느껴져요.","x":"都市生活有時讓人覺得冷漠。","e":"既可以形容空蕩蕩的景色，也可以形容像大城市那樣缺乏人情味的地方。漢字「索漠」，也就是「蕭索冷漠」。","t":"讀作 [상마카다]——鼻音化。","parts":[],"rel":[["황량하다","荒涼"],["각박하다","刻薄、冷酷"],["따뜻하다","溫暖"]],"a":["b033.mp3",1339776,3552,1343328,11328],"nb":["빈곤하다","윤택하다","척박하다","비옥하다","황량하다","적