{"아기":[{"id":"T1-081","de":"아기","rom":"agi","pos":"名詞","lv":"T1","pr":null,"forms":"아기가 · 아기를","m":"嬰兒、寶寶","ex":"아기가 방에서 자요.","x":"寶寶在房間裡睡覺。","e":"아이（或 애）是小孩。","t":"口語中常聽到 애기，但標準拼法是 아기。","parts":[],"rel":[["아이","小孩"],["어린이","兒童"],["엄마","媽媽"]],"a":["b000.mp3",890208,2496,892704,5952],"nb":["아들","딸","남편","아내","결혼","하나","둘","셋"]}],"마흔":[{"id":"T1-095","de":"마흔","rom":"maheun","pos":"數詞","lv":"T1","pr":null,"forms":"native · counting things, age · same before a counter (마흔 살, 마흔두 명)","m":"四十","ex":"삼촌은 올해 마흔이에요.","x":"我叔叔今年四十歲。","e":"固有數詞的整十數都要個別記：스물 20、서른 30、마흔 40、쉰 50。","t":"","parts":[],"rel":[["서른","三十"],["쉰","五十"],["사십","四十（漢字詞）"]],"a":["b000.mp3",1012800,2784,1015584,6240],"nb":["아홉","열","스물","서른","쉰","일","이","삼"]}],"날짜":[{"id":"T1-162","de":"날짜","rom":"naljja","pos":"名詞","lv":"T1","pr":null,"forms":"날짜가 · 날짜를","m":"日期","ex":"시험 날짜가 언제예요?","x":"考試日期是什麼時候？","e":"由 날（日）組成。別和 날씨（天氣）搞混。","t":"問今天幾號：오늘 며칠이에요?（不是 몇 일）。","parts":[],"rel":[["날","日子、天"],["요일","星期幾"],["달력","月曆"]],"a":["b000.mp3",1617792,3456,1621248,5664],"nb":["이번","다음","지난","매일","생일","봄","여름","가을"]}],"서울":[{"id":"T1-214","de":"서울","rom":"seoul","pos":"名詞","lv":"T1","pr":null,"forms":"서울이 · 서울을 · 서울역","m":"首爾（韓國首都）","ex":"서울에는 사람이 정말 많아요.","x":"首爾的人真的很多。","e":"固有詞，原意是「首都」，和大部分韓國地名不同，它沒有漢字。中文寫作「首爾」，以前稱「漢城」。","t":"是兩個音節：서-울，不要唸成一個音。","parts":[],"rel":[["한국","韓國"],["부산","釜山"],["도시","城市"]],"a":["b000.mp3",2168736,2688,2171424,9408],"nb":["일본","영국","독일","프랑스","도시","시골","고향","산"]}],"근처":[{"id":"T1-238","de":"근처","rom":"geuncheo","pos":"名詞","lv":"T1","pr":null,"forms":"근처가 · 근처를 · 근처에 (nearby)","m":"附近、周邊","ex":"집 근처에 편의점이 있어요.","x":"我家附近有便利商店。","e":"漢字「近處」，字面意思是「附近的地方」。","t":"句型：名詞 + 근처에 ＝ …附近，例如 학교 근처에。","parts":[["근","近"],["처","處所"]],"rel":[["가깝다","近"],["주변","周圍"],["옆","旁邊"]],"a":["b000.mp3",2401536,2208,2403744,9696],"nb":["밑","안","밖","사이","오른쪽","왼쪽","가운데","건너편"]}],"신발":[{"id":"T1-331","de":"신발","rom":"sinbal","pos":"名詞","lv":"T1","pr":null,"forms":"신발이 · 신발을","m":"鞋子","ex":"한국 집에서는 신발을 벗어요.","x":"在韓國人家裡要脫鞋。","e":"신（鞋）+ 발（腳）。","t":"穿鞋用 신다，脫鞋用 벗다。","parts":[],"rel":[["신다","穿（鞋）"],["운동화","運動鞋"],["구두","皮鞋"]],"a":["b001.mp3",434976,2592,437568,9024],"nb":["티셔츠","원피스","코트","양말","구두","운동화","모자","가방"]}],"울다":[{"id":"T1-569","de":"울다","rom":"ulda","pos":"動詞","lv":"T1","pr":null,"forms":"울어요 · 울었어요 · 울 거예요 · 우세요 (ㄹ drops)","m":"哭；（鳥）鳴、（動物）叫","ex":"슬픈 영화를 보고 많이 울었어요.","x":"看了悲傷的電影，我哭得很慘。","e":"也用在動物和鳥的叫聲；울음 = 哭聲。別和 웃다（笑）搞混。","t":"ㄹ 在 ㄴ、ㅂ、ㅅ 前面脫落：우세요、우는 아이（在哭的小孩）。","parts":[],"rel":[["웃다","笑"],["슬프다","難過"],["눈물","眼淚"]],"a":["b002.mp3",77472,2304,79776,8928],"nb":["이야기하다","묻다","대답하다","웃다","노래하다","춤추다","여행하다","산책하다"]}],"심심하다":[{"id":"T1-706","de":"심심하다","rom":"simsimhada","pos":"形容詞","lv":"T1","pr":null,"forms":"심심해요 · 심심했어요 · 심심한 (+noun)","m":"無聊、閒得發慌","ex":"주말에 혼자 있어서 심심해요.","x":"週末一個人在家，好無聊。","e":"說食物時也有「有點淡」的意思。심심해요 = 好無聊。","t":"심심하다 = 沒事做很無聊；電影很無聊則是 재미없다。","parts":[],"rel":[["재미없다","沒意思"],["재미있다","有趣"],["바쁘다","忙"]],"a":["b002.mp3",1571904,3168,1575072,8448],"nb":["싫다","반갑다","고맙다","미안하다","늦다","아주","정말","진짜"]}],"계산":[{"id":"T2-0001","de":"계산","rom":"gyesan","pos":"名詞","lv":"T2","pr":null,"forms":"계산이 · 계산을","m":"計算；結帳、買單","ex":"오늘 저녁 계산은 제가 할게요.","x":"今天晚餐我來付。","e":"漢字是「計算」，字面意思是「計數」；在店裡或餐廳是付錢的意思。","t":"在餐廳說「계산해 주세요」= 「麻煩買單」。假朋友：中文「計算」沒有結帳的意思。","parts":[["계","計算"],["산","算"]],"rel":[["계산하다","計算、結帳"],["계산대","結帳櫃檯"],["영수증","收據"]],"a":["b002.mp3",2269344,2880,2272224,8448],"nb":["계산대","교환","교환하다","구입하다"]}],"환전":[{"id":"T2-0025","de":"환전","rom":"hwanjeon","pos":"名詞","lv":"T2","pr":null,"forms":"환전이 · 환전을","m":"換錢、換匯","ex":"여행 전에 은행에서 환전을 했어요.","x":"旅行前我在銀行換了錢。","e":"漢字是「換錢」，和中文一樣。","t":"用 N을/를 N(으)로 환전하다：달러를 원으로 환전하다 =「把美金換成韓元」。","parts":[["환","換"],["전","錢"]],"rel":[["환전하다","換錢（動詞）"],["달러","美元"],["은행","銀行"]],"a":["b002.mp3",2571168,2688,2573856,11040],"nb":["요금","용돈","월급","저금하다","봉투","포장","포장하다","배달"]}],"화려하다":[{"id":"T2-0401","de":"화려하다","rom":"hwaryeohada","pos":"形容詞","lv":"T2","pr":null,"forms":"화려해요 · 화려했어요 · 화려한 (+noun)","m":"華麗、花俏、鮮豔","ex":"파티에 너무 화려한 옷을 입고 갔어요.","x":"我穿了太花俏的衣服去派對。","e":"漢字是「華麗」，和中文一樣。","t":"穿搭上的反義詞是 수수하다「樸素」。","parts":[["화","華"],["려","美麗"]],"rel":[["수수하다","樸素"],["예쁘다","漂亮"],["멋있다","有型"]],"a":["b004.mp3",2116608,2880,2119488,10368],"nb":["흰색","빨간색","파란색","노란색","선글라스","배낭","학년","학기"]}],"꾸다":[{"id":"T2-0792","de":"꾸다","rom":"kkuda","pos":"動詞","lv":"T2","pr":null,"forms":"꿔요 · 꿨어요 · 꿀 거예요 · 꾸세요","m":"做（夢）","ex":"어젯밤에 정말 무서운 꿈을 꿨어요.","x":"昨晚我做了一個很可怕的夢。","e":"名詞 꿈「夢」來自 꾸- + -ㅁ，所以是「夢一個夢」。","t":"一定要說 꿈을 꾸다；就像中文固定說「做夢」，韓文也有固定的動詞。","parts":[],"rel":[["꿈","夢"],["자다","睡覺"],["악몽","惡夢"]],"a":["b006.mp3",1708704,2880,1711584,8736],"nb":["구하다","기르다","키우다","깨지다","끝내다","나다","나타나다","날다"]}],"나타나다":[{"id":"T2-0795","de":"나타나다","rom":"natanada","pos":"動詞","lv":"T2","pr":null,"forms":"나타나요 · 나타났어요 · 나타날 거예요 · 나타나세요","m":"出現、現身","ex":"약속 시간에 늦은 친구가 한 시간 후에 나타났어요.","x":"遲到的朋友在約定時間一小時後才出現。","e":"由 나다「出來」組成：某樣東西出現在眼前。","t":"","parts":[],"rel":[["사라지다","消失"],["보이다","看得見"],["나오다","出來"]],"a":["b006.mp3",1744512,3456,1747968,12384],"nb":["깨지다","꾸다","끝내다","나다","날다","넘다","넘어지다","느끼다"]}],"잠시":[{"id":"T2-0960","de":"잠시","rom":"jamsi","pos":"副詞","lv":"T2","pr":null,"forms":"잠시만요 = Just a moment; 잠시 후에 = shortly","m":"暫時、一會兒、片刻","ex":"손님 여러분, 잠시 후에 열차가 출발합니다.","x":"各位旅客，列車即將出發。","e":"漢字是「暫時」，和中文一樣。","t":"잠시만요 是禮貌地說「請稍等」，或擠過人群時說「借過一下」。","parts":[["잠","暫時"],["시","時間"]],"rel":[["잠깐","一下子"],["금방","馬上"],["오랫동안","很久"]],"a":["b007.mp3",1081920,2496,1084416,11040],"nb":["우선","일부러","자꾸","자세히","점점","정말로","제대로","조용히"]}],"꽃집":[{"id":"T2-1011","de":"꽃집","rom":"kkotjip","pos":"名詞","lv":"T2","pr":"꼳찝","forms":"꽃집이 · 꽃집을","m":"花店","ex":"꽃집에서 장미 한 송이를 샀어요.","x":"我在花店買了一朵玫瑰。","e":"꽃「花」+ 집「房子、店」——很多店名都用 집。","t":"讀作 [꼳찝]——ㅊ 讀成 ㄷ，然後 집 變成緊音。","parts":[],"rel":[["꽃","花"],["꽃다발","花束"],["빵집","麵包店"]],"a":["b007.mp3",1760160,2304,1762464,9024],"nb":["시청","주민센터","경찰서","빵집","옷가게","문구점","세탁소","찜질방"]}],"나비":[{"id":"T2-1044","de":"나비","rom":"nabi","pos":"名詞","lv":"T2","pr":null,"forms":"나비가 · 나비를","m":"蝴蝶","ex":"꽃 위에 노란 나비가 앉아 있어요.","x":"花上停著一隻黃色的蝴蝶。","e":"也是經典的貓咪名字——叫貓咪時會喊「나비야!」。","t":"","