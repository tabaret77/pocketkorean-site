{"부럽다":[{"id":"T2-0160","de":"부럽다","rom":"bureopda","pos":"形容詞","lv":"T2","pr":"부럽따","forms":"부러워요 · 부러웠어요 · 부러운 (+noun) (ㅂ irregular)","m":"羨慕","ex":"제 친구는 영어를 잘해서 정말 부러워요.","x":"我朋友英文很好，真的好羨慕。","e":"加 -어하다 描述別人的羨慕：친구가 저를 부러워해요（朋友羨慕我）。","t":"부러워요! 是友善的「好羨慕喔！」；帶有酸意或感情上的嫉妒是 질투하다（嫉妒）。","parts":[],"rel":[["부러워하다","羨慕"],["질투하다","嫉妒"],["자랑하다","炫耀"]],"a":["b003.mp3",1581408,2496,1583904,12576],"nb":["걱정","걱정하다","놀라다","궁금하다","부끄럽다","답답하다","외롭다","그립다"]}],"계획하다":[{"id":"T2-0287","de":"계획하다","rom":"gyehoekada","pos":"動詞","lv":"T2","pr":"계회카다","forms":"계획해요 · 계획했어요 · 계획할 거예요 · 계획하세요","m":"計畫、規劃","ex":"우리는 다음 달 여행을 같이 계획하고 있어요.","x":"我們正在一起規劃下個月的旅行。","e":"漢字是「計劃」，和中文一樣。","t":"用名詞就說 계획을 세우다「訂計畫」，字面是「把計畫立起來」。","parts":[["계","計算"],["획","劃"]],"rel":[["계획","計畫"],["일정","行程"],["준비하다","準備"]],"a":["b004.mp3",499680,2976,502656,11616],"nb":["안내하다","지도","가이드","일정","예약","취소","취소하다","숙소"]}],"계속하다":[{"id":"T2-0862","de":"계속하다","rom":"gyesokada","pos":"動詞","lv":"T2","pr":"계소카다","forms":"계속해요 · 계속했어요 · 계속할 거예요 · 계속하세요","m":"繼續、持續做","ex":"힘들어도 저는 운동을 계속할 거예요.","x":"就算很辛苦，我也會繼續運動。","e":"漢字是「繼續」，和中文一樣，兩個字都是「接下去」的意思。","t":"계속 單獨用可以當副詞：계속 비가 와요 = 一直下雨。讀作 [계소카다]。","parts":[["계","繼續"],["속","接續"]],"rel":[["계속","一直、不斷"],["그만두다","放棄、辭掉"],["멈추다","停止"]],"a":["b006.mp3",2663520,3168,2666688,11520],"nb":["흐르다","결정하다","경험","경험하다","고생하다","노력","노력하다","늦잠"]}],"노력":[{"id":"T2-0864","de":"노력","rom":"noryeok","pos":"名詞","lv":"T2","pr":null,"forms":"노력이 · 노력을","m":"努力","ex":"좋은 결과를 얻으려면 노력이 필요해요.","x":"想要有好結果就需要努力。","e":"漢字是「努力」，和中文一樣。","t":"","parts":[["노","努力"],["력","力量"]],"rel":[["노력하다","努力（動詞）"],["열심히","認真地"],["성공","成功"]],"a":["b006.mp3",2693280,1728,2695008,11040],"nb":["경험","경험하다","계속하다","고생하다","노력하다","늦잠","등록하다","목욕하다"]}],"상관없다":[{"id":"T2-0926","de":"상관없다","rom":"sanggwaneopda","pos":"形容詞","lv":"T2","pr":"상과넙따","forms":"상관없어요 · 상관없었어요 · 상관없는 (+noun)","m":"沒關係、無所謂；不相干","ex":"저는 아무 음식이나 다 상관없어요.","x":"我吃什麼都無所謂。","e":"漢字「相關」+ 없다（沒有）=「不相關」。","t":"讀作 [상과넙따]。別人問你想要什麼時，可以回答：저는 상관없어요（我都可以）。","parts":[["상","互相"],["관","關聯"]],"rel":[["괜찮다","沒關係、還好"],["관계없다","無關"],["상관","關係、干涉"]],"a":["b007.mp3",640512,3168,643680,9792],"nb":["튼튼하다","편리하다","급하다","부족하다","가장","갑자기","거의","결국"]}],"예정":[{"id":"T2-1095","de":"예정","rom":"yejeong","pos":"名詞","lv":"T2","pr":null,"forms":"예정이 · 예정을","m":"預定、計畫；預計","ex":"저는 다음 주에 부산에 갈 예정이에요.","x":"我預計下週去釜山。","e":"漢字是「豫定」，也就是中文的「預定」。","t":"用句型 -(으)ㄹ 예정이에요 表示已經排定或計畫好的事。","parts":[["예","預先"],["정","定"]],"rel":[["계획","計畫"],["일정","行程"],["예약","預約、訂位"]],"a":["b007.mp3",2871840,2784,2874624,12096],"nb":["얘기","언어","연세","예","오해","우표","엽서","운"]}],"회복하다":[{"id":"T3-0153","de":"회복하다","rom":"hoebokada","pos":"動詞","lv":"T3","pr":"회보카다","forms":"회복해요 · 회복했어요 · 회복할 거예요 · 회복하세요","m":"恢復、康復；挽回","ex":"충분히 쉬고 나서 건강을 회복했어요.","x":"充分休息之後，身體恢復健康了。","e":"漢字「回復」加上 -하다。","t":"不只用在健康上：신뢰를 회복하다，就是「重建信任」。","parts":[["회","回"],["복","復原"]],"rel":[["회복","恢復"],["낫다","痊癒、好轉"],["퇴원하다","出院"]],"a":["b008.mp3",2447424,3264,2450688,9696],"nb":["반창고","부작용","효과","회복","영양","살을 빼다","스트레스","피로"]}],"존경하다":[{"id":"T3-0266","de":"존경하다","rom":"jongyeonghada","pos":"動詞","lv":"T3","pr":null,"forms":"존경해요 · 존경했어요 · 존경할 거예요 · 존경하세요","m":"尊敬、敬佩、景仰","ex":"제가 가장 존경하는 사람은 우리 어머니예요.","x":"我最尊敬的人是我媽媽。","e":"漢字「尊敬」加上 -하다。","t":"존경하다 是景仰某人；존중하다 是尊重任何人的權利、意見或選擇。","parts":[["존","尊"],["경","敬"]],"rel":[["존경","尊敬"],["존중하다","尊重"],["선배","學長姐、前輩"]],"a":["b009.mp3",1104672,3360,1108032,12288],"nb":["전통","예절","예의 바르다","존경","존중","세배","제사","한옥"]}],"주장하다":[{"id":"T3-0608","de":"주장하다","rom":"jujanghada","pos":"動詞","lv":"T3","pr":null,"forms":"주장해요 · 주장했어요 · 주장할 거예요 · 주장하세요","m":"主張、堅稱、堅持（說法）","ex":"그는 자신이 옳다고 계속 주장했어요.","x":"他一直堅稱自己是對的。","e":"字面意思是「伸張自己的主要論點」。漢字是「主張」，和中文一樣。","t":"通常和 -다고 一起用：옳다고 주장하다「堅稱自己是對的」。","parts":[["주","主要"],["장","伸張"]],"rel":[["주장","主張"],["반대하다","反對"],["말하다","說"]],"a":["r04.mp3",573288,2688,575976,8352],"nb":["기능","입장","관점","주장","사례","관련","관련되다","성공"]}],"선택":[{"id":"T3-0623","de":"선택","rom":"seontaek","pos":"名詞","lv":"T3","pr":null,"forms":"선택이 · 선택을","m":"選擇","ex":"어떤 길을 갈지는 여러분의 선택이에요.","x":"要走哪條路，是各位自己的選擇