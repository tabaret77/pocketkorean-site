{"좋아하다":[{"id":"T1-528","de":"좋아하다","rom":"joahada","pos":"動詞","lv":"T1","pr":"조아하다","forms":"좋아해요 · 좋아했어요 · 좋아할 거예요 · 좋아하세요","m":"喜歡","ex":"저는 매운 음식을 좋아해요.","x":"我喜歡吃辣的食物。","e":"좋다（好）+ -아하다（表現感受）。좋아요 = 很好；좋아해요 = 我喜歡。","t":"좋아하다 用 을/를（음식을 좋아해요）；좋다 用 이/가（음식이 좋아요）。讀作 [조아하다]。","parts":[],"rel":[["좋다","好"],["싫어하다","討厭"],["사랑하다","愛"]],"a":["b001.mp3",2497824,3360,2501184,7392],"nb":["하다","되다","알다","모르다","싫어하다","사랑하다","기다리다","부르다"]}],"가볍다":[{"id":"T1-639","de":"가볍다","rom":"gabyeopda","pos":"形容詞","lv":"T1","pr":"가볍따","forms":"가벼워요 · 가벼웠어요 · 가벼운 (+noun) (ㅂ irregular)","m":"輕","ex":"이 노트북은 아주 가벼워요.","x":"這台筆電非常輕。","e":"ㅂ 變成 우：가벼워요。相反：무겁다。","t":"","parts":[],"rel":[["무겁다","重"],["가방","包包"]],"a":["b002.mp3",869376,3168,872544,7488],"nb":["낮다","넓다","좁다","무겁다","빠르다","느리다","멀다","가깝다"]}],"구입하다":[{"id":"T2-0005","de":"구입하다","rom":"guipada","pos":"動詞","lv":"T2","pr":"구이파다","forms":"구입해요 · 구입했어요 · 구입할 거예요 · 구입하세요","m":"購買、購入","ex":"저는 인터넷으로 책을 자주 구입해요.","x":"我常在網路上買書。","e":"漢字是「購入」，字面意思是「買進來」。","t":"比 사다 正式；在商店、廣告和書面上會看到。讀作 [구이파다]。","parts":[["구","購買"],["입","進入"]],"rel":[["사다","買"],["판매하다","販賣"],["쇼핑","購物"]],"a":["b002.mp3",2315232,2688,2317920,12192],"nb":["계산","계산대","교환","교환하다","깎다","할인","세일","무료"]}],"셋째":[{"id":"T2-0689","de":"셋째","rom":"setjjae","pos":"數詞","lv":"T2","pr":"섿째","forms":"셋째 아이 · 셋째 날 · 셋째로 (thirdly)","m":"第三；老三","ex":"여행 셋째 날에는 가족과 바닷가에 갔어요.","x":"旅行的第三天，我和家人去了海邊。","e":"셋「三」加上 -째「順序」。","t":"","parts":[],"rel":[["둘째","第二"],["넷째","第四"],["세 번째","第三次、第三個"]],"a":["b006.mp3",328320,2496,330816,13056],"nb":["친척","막내","첫째","둘째","쌍둥이","어린이","청소년","노인"]}],"계곡":[{"id":"T2-1029","de":"계곡","rom":"gyegok","pos":"名詞","lv":"T2","pr":null,"forms":"계곡이 · 계곡을","m":"溪谷、山谷","ex":"여름에 가족들과 계곡에 놀러 갔어요.","x":"夏天我和家人去溪谷玩。","e":"漢字是「溪谷」，和中文一樣——有溪水的山谷。","t":"","parts":[["계","溪"],["곡","山谷"]],"rel":[["산","山"],["강","江、河"],["물","水"]],"a":["b007.mp3",2002272,2112,2004384,10272],"nb":["땅","바위","모래","숲","파도","공기","환경","나뭇잎"]}],"염색":[{"id":"T3-0188","de":"염색","rom":"yeomsaek","pos":"名詞","lv":"T3","pr"