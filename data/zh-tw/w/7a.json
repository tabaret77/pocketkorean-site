思。","parts":[],"rel":[["짜장면","炸醬麵"],["탕수육","糖醋肉"],["배달","外送"]],"a":["b057.mp3",308232,2376,310608,9288],"nb":["어묵","튀김","막걸리","건배","목욕탕","한강","그룹","멤버"]}],"수입하다":[{"id":"T3-0079","de":"수입하다","rom":"suipada","pos":"動詞","lv":"T3","pr":"수이파다","forms":"수입해요 · 수입했어요 · 수입할 거예요 · 수입하세요","m":"進口、輸入","ex":"우리 회사는 프랑스에서 와인을 수입해요.","x":"我們公司從法國進口葡萄酒。","e":"漢字是「輸入」，也就是進口。","t":"別和同音的 수입（收入）「收入」搞混——靠上下文判斷。","parts":[["수","運輸"],["입","進入"]],"rel":[["수출하다","出口"],["무역","貿易"],["외국","外國"]],"a":["b008.mp3",1439136,3264,1442400,11328],"nb":["생산하다","제품","상품","수출","고객","거래","손해","이익"]}],"다양하다":[{"id":"T3-0306","de":"다양하다","rom":"dayanghada","pos":"形容詞","lv":"T3","pr":null,"forms":"다양해요 · 다양했어요 · 다양한 (+noun)","m":"多樣、各式各樣","ex":"이 시장에서는 다양한 음식을 팔아요.","x":"這個市場賣各式各樣的食物。","e":"漢字是「多樣」，和中文一樣。","t":"","parts":[["다","多"],["양","樣子"]],"rel":[["여러","好幾個、各種"],["다양성","多樣性"],["비슷하다","相似"]],"a":["b009.mp3",1681152,2976,1684128,9312],"nb":["기도하다","상징","특징","독특하다","차이","차이점","공통점","적응"]}],"지각":[{"id":"T3-0493","de":"지각","rom":"jigak","pos":"名詞","lv":"T3","pr":null,"forms":"지각이 · 지각을","m":"遲到","ex":"늦잠을 자서 오늘 회사에 지각했어요.","x":"我睡過頭，今天上班遲到了。","e":"漢字是「遲刻」，也就是遲到。","t":"同音詞注意：지각（知覺）也是「知覺」的意思，但「遲到」常用得多。","parts":[["지","遲"],["각","時刻"]],"rel":[["지각하다","遲到"],["늦다","晚"],["결석","缺席"]],"a":["b010.mp3",1521696,2016,1523712,10752],"nb":["토론하다","출석","출석하다","결석","휴학","복습","암기","깨닫다"]},{"id":"T6-0609","de":"지각","rom":"jigak","pos":"名詞","lv":"T6","pr":null,"forms":"지각이 · 지각을","m":"知覺","ex":"사람마다 색에 대한 지각이 조금씩 달라요.","x":"每個人對顏色的知覺都有些不同。","e":"字面意思是「透過感官知道」，和中文的「知覺」相同。","t":"同音詞：表示「遲到」的 지각 在日常生活中常用得多——학교에 지각했어요（上學遲到了）。","parts":[["지","知道"],["각","覺"]],"rel":[["감각","感覺"],["인지","認知"],["착시","錯視"],["지각하다","知覺"]],"a":["b044.mp3",1878144,1920,1880064,13344],"nb":["과잉행동","인지능력","인지부조화","인지행동치료","착시","성정","심성","품성"]}],"대상":[{"id":"T3-0639","de":"대상","rom":"daesang","pos":"名詞","lv":"T3","pr":null,"forms":"대상이 · 대상을","m":"對象、目標；（研究）對象、受眾","ex":"이 영어 프로그램은 초등학생을 대상으로 합니다.","x":"這個英文課程是以國小學生為對象。","e":"字面意思是「面對的形象」——某件事針對的目標。漢字是「對象」，但中文「