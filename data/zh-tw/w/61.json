{"여기":[{"id":"T1-029","de":"여기","rom":"yeogi","pos":"代名詞","lv":"T1","pr":null,"forms":"여기가 · 여기에 (to/at here) · 여기서 (from/at here)","m":"這裡、這兒","ex":"여기가 제가 다니는 학교예요.","x":"這裡是我上的學校。","e":"同樣是 이/그/저 的規律：여기（這裡）、거기（那裡）、저기（遠處那裡）。","t":"在餐廳說 여기요! 也是叫服務生的常用說法。","parts":[],"rel":[["거기","那裡"],["저기","那裡（遠處）"],["어디","哪裡"]],"a":["b000.mp3",353568,2496,356064,7488],"nb":["너","이것","그것","저것","거기","저기","누구","무엇"]}],"젓가락":[{"id":"T1-288","de":"젓가락","rom":"jeotgarak","pos":"名詞","lv":"T1","pr":"저까락","forms":"젓가락이 · 젓가락을","m":"筷子","ex":"젓가락을 잘 사용해요?","x":"你很會用筷子嗎？","e":"저（筷子的漢字詞「箸」）+ ㅅ + 가락（細長條），和 숟가락、손가락 一樣。","t":"讀作 [저까락] 或 [젇까락]。韓國筷子通常是金屬製、扁平的。","parts":[],"rel":[["숟가락","湯匙"],["수저","湯匙和筷子"],["그릇","碗"]],"a":["b000.mp3",2887776,3168,2890944,5952],"nb":["소금","맛","반찬","숟가락","컵","접시","메뉴","식사"]}],"그림":[{"id":"T1-456","de":"그림","rom":"geurim","pos":"名詞","lv":"T1","pr":null,"forms":"그림이 · 그림을","m":"圖畫、畫","ex":"동생이 고양이 그림을 그렸어요.","x":"弟弟（妹妹）畫了一張貓的圖。","e":"來自 그리다（畫）。","t":"「畫畫」= 그림을 그리다。照片是 사진，不是 그림。","parts":[],"rel":[["그리다","畫"],["사진","照片"],["미술관","美術館"]],"a":["b001.mp3",1779936,2400,1782336,9696],"nb":["영화","음악","노래","춤","게임","독서","산책","피아노"]}],"일어나다":[{"id":"T1-496","de":"일어나다","rom":"ireonada","pos":"動詞","lv":"T1","pr":"이러나다","forms":"일어나요 · 일어났어요 · 일어날 거예요 · 일어나세요","m":"起床、醒來；站起來；發生","ex":"저는 매일 일곱 시에 일어나요.","x":"我每天七點起床。","e":"일다（升起）+ 나다（出來）—「升起來」：起床、站起來，或發生。","t":"讀作 [이러나다]：ㄹ 收尾音連到下一個母音。","parts":[],"rel":[["자다","睡覺"],["아침","早上"],["깨다","醒來"]],"a":["b001.mp3",2184384,3360,2187744,9696],"nb":["오다","먹다","마시다","자다","보다","듣다","말하다","읽다"]}],"멀다":[{"id":"T1-642","de":"멀다","rom":"meolda","pos":"形容詞","lv":"T1","pr":null,"forms":"멀어요 · 멀었어요 · 먼 (+noun) (ㄹ drops)","m":"遠","ex":"집에서 회사까지 좀 멀어요.","x":"從家裡到公司有點遠。","e":"ㄹ 在 ㄴ 前面脫落：먼 곳（遠方）。相反：가깝다。","t":"常見句型：A에서 B까지 멀어요 = 從A到B很遠。","parts":[],"rel":[["가깝다","近"],["거리","距離"]],"a":["b002.mp3",901056,2304,903360,6816],"nb":["무겁다","가볍다","빠르다","느리다","가깝다","비싸다","싸다","맛있다"]}],"호주":[{"id":"T2-0312","de":"호주","rom":"hoju","pos":"名詞","lv":"T2","pr":null,"for