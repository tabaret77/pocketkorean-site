de-(제거) + Karbon(탄소; 라틴어 carbo) + -isieren","rel":[{"de":"die Dekarbonisierung","ko":"탈탄소화"},{"de":"der Kohlenstoff","ko":"탄소"},{"de":"klimaneutral","ko":"탄소 중립의"}],"pos":"동사"},"C1-4259":{"de":"der Nebeneffekt","lv":"C1","forms":"Pl. die Nebeneffekte","ko":"부수 효과; 부차적 효과","ex":"Ein positiver Nebeneffekt des Homeoffice ist weniger Verkehr.","exk":"재택근무의 긍정적인 부수 효과는 교통량 감소예요.","ety":"neben(곁의) + der Effekt(효과)","rel":[{"de":"die Nebenwirkung","ko":"부작용"},{"de":"die Begleiterscheinung","ko":"부수 현상"},{"de":"der Haupteffekt","ko":"주효과"}],"tip":"약의 부작용은 die Nebenwirkung","pos":"명사"},"C2-744":{"de":"nur noch Haut und Knochen sein","lv":"C2","ko":"뼈와 가죽만 남다; 피골이 상접하다","ex":"Nach der langen Krankheit war er nur noch Haut und Knochen.","exk":"오랜 병 끝에 그는 피골이 상접했어요.","ety":"Haut(피부)와 Knochen(뼈)밖에 안 남음","rel":[{"de":"abgemagert","ko":"수척한"},{"de":"ausgezehrt","ko":"쇠약한"},{"de":"dürr","ko":"깡마른"}],"pos":"표현"},"C2-1477":{"de":"der Quacksalber","lv":"C2","forms":"Pl. die Quacksalber","ko":"돌팔이 의사","ex":"Statt zum Arzt zu gehen, vertraute er einem Quacksalber mit Wunderpillen.","exk":"그는 의사에게 가는 대신 기적의 알약을 파는 돌팔이를 믿었어요.","ety":"quacken(떠벌리다) + die Salbe(연고) → 연고를 떠벌리며 파는 자","rel":[{"de":"der Scharlatan","ko":"협잡꾼"},{"de":"die Salbe","ko":"연고"},{"de":"das Wundermittel","ko":"만병통치약"}],"pos":"명사"},"C2-2069":{"de":"sich davonmachen","lv":"C2","forms":"macht sich davon – hat sich davongemacht","ko":"슬그머니 사라지다, 내빼다","ex":"Noch vor dem Abwasch hatte er sich heimlich davongemacht.","exk":"설거지도 하기 전에 그는 슬그머니 내빼 버렸어요.","ety":"davon(거기서 떨어져) + machen","rel":[{"de":"sich verdrücken","ko":"몰래 빠지다"},{"de":"abhauen","ko":"튀다"},{"de":"sich aus dem Staub machen","ko":"줄행랑치다"}],"pos":"동사"},"C2-2546":{"de":"der Publizist","lv":"C2","forms":"Pl. die Publizisten (여: die Publizistin)","ko":"논객; 시사 평론가","ex":"Der bekannte Publizist meldet sich regelmäßig mit Essays zur Lage der Nation zu Wort.","exk":"그 유명한 논객은 국가 상황에 대한 에세이로 정기적으로 발언해요.","ety":"라틴어 publicus(공적인) → Publizistik(시사 저술)에서","rel":[{"de":"die 