g geplant.","exk":"새 장관의 임명은 월요일로 예정돼 있어요.","ety":"er- + nennen(이름을 부르다) → ernennen(이름 불러 자리에 앉히다) · -ung 명사화","rel":[{"de":"ernennen","ko":"임명하다"},{"de":"die Wahl","ko":"선거"},{"de":"die Berufung","ko":"임용"}],"pos":"명사"},"C2-129":{"de":"die Tücke","lv":"C2","forms":"Pl. die Tücken","ko":"간계, 함정, 까다로움","ex":"Die Software hat ihre Tücken.","exk":"그 소프트웨어는 은근히 까다로워요.","ety":"원래 '음흉한 행동'","rel":[{"de":"tückisch","ko":"교활한, 까다로운"},{"de":"die Falle","ko":"함정"},{"de":"die List","ko":"책략"}],"tip":"die Tücke des Objekts = 물건이 말 안 듣는 심술","pos":"명사"},"C2-594":{"de":"etwas vom Tisch wischen","lv":"C2","ko":"~를 일축하다","ex":"Der Minister wischte die Bedenken der Experten einfach vom Tisch.","exk":"장관은 전문가들의 우려를 그냥 일축했어요.","ety":"탁자(der Tisch) 위 물건을 손으로 쓸어(wischen) 치우는 모습","rel":[{"de":"abtun","ko":"일축하다"},{"de":"ignorieren","ko":"무시하다"},{"de":"zurückweisen","ko":"거부하다"}],"pos":"표현"},"C2-730":{"de":"Ross und Reiter nennen","lv":"C2","ko":"책임자를 실명으로 밝히다","ex":"Wenn Sie Vorwürfe erheben, müssen Sie auch Ross und Reiter nennen.","exk":"비난을 제기하려면 책임자를 분명히 밝혀야 해요.","ety":"말(Ross)과 기수(Reiter)를 지목하는 기마 시대의 이미지","rel":[{"de":"beim Namen nennen","ko":"이름을 대다"},{"de":"die Verantwortlichen","ko":"책임자들"},{"de":"anprangern","ko":"규탄하다"}],"pos":"표현"},"C2-907":{"de":"läutern","lv":"C2","forms":"läutert – hat geläutert","ko":"정화하다; (사람을) 성숙하게 하다","ex":"Die Jahre im Gefängnis hatten ihn geläutert.","exk":"감옥에서 보낸 세월이 그를 새사람으로 만들었어요.","ety":"lauter(순수한)에서 나온 동사","rel":[{"de":"lauter","ko":"순수한"},{"de":"die Läuterung","ko":"정화"},{"de":"reinigen","ko":"깨끗이 하다"}],"pos":"동사"},"C2-990":{"de":"impertinent","lv":"C2","ko":"무례한; 뻔뻔한","ex":"Die Frage des Reporters empfand der Senator als impertinent.","exk":"상원의원은 기자의 질문을 무례하다고 여겼어요.","ety":"라틴어 impertinens(관계없는)에서 프랑스어 거쳐","rel":[{"de":"die Impertinenz","ko":"무례함"},{"de":"unverschämt","ko":"뻔뻔한"},{"de":"höflich","ko":"예의 바른"}],"pos":"형용사"},"C2-1036":{"de":"die Erhabenheit","lv":"C2","forms":"Sg.","ko":"숭고함; 장엄함","ex":"Die Erhabenheit der Gebirgslandschaft ließ die Reisenden verstummen.","exk":"산악 풍경의 장엄함에 여행객들은 말을 잃었어요.","ety":"erhaben(숭고한) ← erheben(들어 올리다; er- + heben 들다)의 옛 과거분사 · -heit","rel":[{"de":"erhaben","ko":"숭고한"},{"de":"die Würde","ko":"품위"},{"de":"die Banalität","ko":"진부함"}],"pos":"명사"},"C2-1465":{"de":"die Unwägbarkeit","lv":"C2","forms":"Pl. die Unwägbarkeiten","ko":"예측 불가능성; 불확실 요소","ex":"Trotz aller Unwägbarkeiten hält der Vorstand an der Prognose fest.","exk":"온갖 불확실 요소에도 불구하고 이사회는 전망을 고수해요.","ety":"un- + wägbar(잴 수 있는; wägen 무게를 달다, wiegen과 같은 뿌리 + -bar) + -keit","rel":[{"de":"unwägbar","ko":"예측할 수 없는"},{"de":"das Risiko","ko":"위험"},{"de":"die Ungewissheit","ko":"불확실성"}],"tip":"Waage(저울)로 잴 수 없는 것","pos":"명사"},"C2-2572":{"de":"das Leitmedium","lv":"C2","forms":"Pl. die Leitmedien","ko":"주류 언론; 여론 주도 매체","ex":"Das Fernsehen hat seine Rolle als Leitmedium längst an das Internet verloren.","exk":"텔레비전은 이미 오래전에 여론 주도 매체의 역할을 인터넷에 넘겨줬어요.","ety":"leiten(이끌다) + Medium(매체)","rel":[{"de":"der Mainstream","ko":"주류"},{"de":"die Qualitätspresse","ko":"고급 언론"},{"de":"das Massenmedium","ko":"대중 매체"}],"pos":"명사"},"C2-3232":{"de":"schäkern","lv":"C2","forms":"schäkert – hat geschäkert","ko":"(가볍게) 시시덕거리다; 농담하며 장난치다","ex":"Die Kellnerin schäkerte ein wenig mit den Stammgästen an der Bar.","exk":"여종업원은 바에 앉은 단골손님들과 조금 시시덕거렸어요.","ety":"이디시어 chek(품, 가슴)에서(설)","rel":[{"de":"flirten","ko":"추파를 던지다"},{"de":"necken","ko":"놀리다"},{"de":"kokettieren","ko":"교태를 부리다"}],"pos":"동사"},"C2-3368":{"de":"sich häuslich einrichten","lv":"C2","forms":"richtet sich häuslich ein – hat sich häuslich eingerichtet","ko":"눌러앉다, 자리 잡고 편히 지내다","ex":"Der Besuch hatte sich in unserem Gästezimmer schon häuslich eingerichtet.","exk":"손님은 우리 손님방에 벌써 눌러앉아 버렸어요.","ety":"häuslich(집의) + sich einrichten(자리 잡다)","rel":[{"de":"sich einnisten","ko":"둥지를 틀다"},{"de":"häuslich","ko":"가정적인"},{"de":"sich breitmachen","ko":"자리를 차지하다"}],"pos":"표현"},"C2-3438":{"de":"der Krösus","lv":"C2","forms":"Pl. die Krösusse","ko":"대부호, 엄청난 부자","ex":"Ich bin doch kein Krösus, der jeden Monat ein neues Handy kauft!","exk":"내가 매달 새 휴대폰 사는 갑부도 아니잖아!","ety":"부유했던 리디아 왕 크로이소스(Kroisos)의 이름에서","rel":[{"de":"der Millionär","ko":"백만장자"},{"de":"steinreich","ko":"엄청 부자인"},{"de":"der Geldsack","ko":"돈자루, 부자"}],"tip":"주로 부정문: \"Ich bin doch kein Krösus!\" = 나 그렇게 부자 아님","pos":"명사"},"C2-3553":{"de":"der Kauz","lv":"C2","forms":"Pl. die Käuze","ko":"괴짜; (동물) 올빼미","ex":"Der alte Professor war ein komischer Kauz.","exk":"그 노교수는 별난 괴짜였어요.","ety":"원래 올빼미의 일종","rel":[{"de":"kauzig","ko":"별난"},{"de":"der Sonderling","ko":"괴짜"},{"de":"die Eule","ko":"올빼미"}],"tip":"ein komischer Kauz = 별난 사람","pos":"명사"},"C2-3647":{"de":"demiurgisch","lv":"C2","ko":"창조주 같은; 세계를 빚어내는","ex":"Der Regisseur tritt mit demiurgischem Anspruch auf.","exk":"그 감독은 창조주 같은 야심을 품고 나타나요.","ety":"그리스어 demiourgos(장인, 조물주)에서","rel":[{"de":"der Demiurg","ko":"조물주"},{"de":"schöpferisch","ko":"창조적인"},{"de":"allmächtig","ko":"전능한"}],"pos":"형용사"},"C2-3904":{"de":"hochnehmen","lv":"C2","forms":"nimmt hoch – nahm hoch – hat hochgenommen","ko":"들어 올리다; (구어) 놀리다; (경찰이) 덮치다, 검거하다","ex":"Die Kollegen nehmen ihn wegen seiner Krawatte ständig hoch.","exk":"동료들은 넥타이 때문에 늘 그를 놀려요.","ety":"hoch(위로) + nehmen(잡다): 들어올려 웃음거리로 만들기","rel":[{"de":"aufziehen","ko":"놀리다"},{"de":"veräppeln","ko":"놀리다"},{"de":"festnehmen","ko":"체포하다"}],"pos":"동사"},"C2-3971":{"de":"läppisch","lv":"C2","ko":"하찮은; 유치한","ex":"Wir haben uns wegen einer läppischen Kleinigkeit gestritten.","exk":"우리는 하찮은 일로 싸웠어요.","ety":"der Lappe(바보; 헝겊)에서(설)","rel":[{"de":"lächerlich","ko":"우스운"},{"de":"albern","ko":"유치한"},{"de":"belanglos","ko":"사소한"}],"tip":"läppische zehn Euro = 고작 10유로","pos":"형용사"},"C2-4031":{"de":"jemanden aus dem Konzept bringen","lv":"C2","ko":"~를 당황하게 해 흐름을 놓치게 하다","ex":"Das klingelnde Handy brachte den Redner völlig aus dem Konzept.","exk":"울리는 휴대폰 때문에 연사가 완전히 흐름을 놓쳤어요.","ety":"das Konzept(원래 연설 원고 초안)에서 벗어나게 만들기","rel":[{"de":"verwirren","ko":"혼란스럽게 하다"},{"de":"den Faden verlieren","ko":"말의 흐름을 잃다"},{"de":"irritieren","ko":"신경 쓰이게