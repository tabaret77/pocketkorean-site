:[{"de":"der Torwart","ko":"골키퍼"},{"de":"das Tor","ko":"골, 골문"},{"de":"der Stürmer","ko":"공격수"}],"pos":"명사"},"B2-3937":{"de":"das Ass","lv":"B2","forms":"Pl. die Asse","ko":"(카드) 에이스; 최고 실력자; (테니스) 서브 에이스","ex":"Er hat noch ein Ass im Ärmel.","exk":"그는 아직 비장의 카드를 숨기고 있어요.","ety":"라틴어 as(1단위)에서 프랑스어를 거쳐","rel":[{"de":"die Karte","ko":"카드"},{"de":"der Profi","ko":"프로"},{"de":"der Trumpf","ko":"으뜸패"}],"tip":"\"ein Ass im Ärmel haben\" = 비장의 카드가 있음","pos":"명사"},"B2-4077":{"de":"hauen","lv":"B2","forms":"haut – hat gehauen","ko":"(구어) 때리다, 치다; (못 등을) 박다","ex":"Er hat mir freundlich auf die Schulter gehauen.","exk":"그는 친근하게 제 어깨를 툭 쳤어요.","rel":[{"de":"schlagen","ko":"때리다"},{"de":"abhauen","ko":"(구어) 도망가다"},{"de":"umhauen","ko":"쓰러뜨리다"}],"tip":"Das haut mich um! = 진짜 놀랍다!","pos":"동사"},"B2-4183":{"de":"der Syrer","lv":"B2","forms":"Pl. die Syrer","ko":"시리아 사람","ex":"Mein Kollege ist Syrer und spricht Arabisch.","exk":"제 동료는 시리아 사람이고 아랍어를 해요.","ety":"Syrien + -er(~ 사람)","rel":[{"de":"die Syrerin","ko":"시리아 여자"},{"de":"Syrien","ko":"시리아"},{"de":"syrisch","ko":"시리아의"}],"tip":"국적은 관사 없이: Er ist Syrer.","pos":"명사"},"C1-507":{"de":"die Fehlerquelle","lv":"C1","forms":"Pl. die Fehlerquellen","ko":"오류의 원인","ex":"Eine häufige Fehlerquelle ist die ungenaue Kalibrierung der Geräte.","exk":"흔한 오류 원인은 장비의 부정확한 보정이에요.","ety":"der Fehler(오류) + die Quelle(근원)","rel":[{"de":"der Fehler","ko":"오류"},{"de":"die Ungenauigkeit","ko":"부정확성"},{"de":"ausschließen","ko":"배제하다"}],"pos":"명사"},"C1-693":{"de":"das Tagesgeschäft","lv":"C1","forms":"Sg.","ko":"일상 업무","ex":"Im hektischen Tagesgeschäft bleibt oft keine Zeit für langfristige Planung.","exk":"바쁜 일상 업무 속에서는 장기 계획을 세울 시간이 없는 경우가 많아요.","ety":"der Tag(날) + -es- + das Geschäft(업무)","rel":[{"de":"das Kerngeschäft","ko":"핵심 사업"},{"de":"die Routine","ko":"일상"},{"de":"operativ","ko":"운영상의"}],"pos":"명사"},"C1-932":{"de":"das Wahlversprechen","lv":"C1","forms":"Pl. die Wahlversprechen","ko":"선거 공약","ex":"Kritiker werfen der Regierung vor, zentrale Wahlve