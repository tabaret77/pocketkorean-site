09":{"de":"bedrohen","lv":"B2","forms":"bedroht – hat bedroht","ko":"위협하다","ex":"Viele Tierarten sind vom Aussterben bedroht.","exk":"많은 동물 종이 멸종 위기에 처해 있어요.","ety":"be- + drohen(위협하다)","rel":[{"de":"die Bedrohung","ko":"위협"},{"de":"gefährden","ko":"위태롭게 하다"},{"de":"schützen","ko":"보호하다"}],"pos":"동사"},"B2-406":{"de":"das Anschreiben","lv":"B2","forms":"Pl. die Anschreiben","ko":"(지원서의) 커버레터; 자기소개 편지","ex":"Im Anschreiben sollten Sie Ihre Motivation klar erklären.","exk":"커버레터에서는 지원 동기를 분명히 설명해야 해요.","ety":"an(~에게) + schreiben(쓰다) 명사화","rel":[{"de":"der Lebenslauf","ko":"이력서"},{"de":"die Bewerbung","ko":"지원"},{"de":"die Motivation","ko":"동기"}],"pos":"명사"},"B2-785":{"de":"der Deich","lv":"B2","forms":"Pl. die Deiche","ko":"제방, 둑","ex":"An der Nordsee schützen Deiche das Land vor dem Meer.","exk":"북해에서는 제방이 바다로부터 땅을 지켜요.","ety":"저지독일어에서 · 영어 dike와 같은 뿌리","rel":[{"de":"der Damm","ko":"댐, 둑"},{"de":"das Hochwasser","ko":"홍수"},{"de":"die Küste","ko":"해안"}],"pos":"명사"},"B2-965":{"de":"fälschen","lv":"B2","forms":"fälscht – hat gefälscht","ko":"위조하다; 조작하다","ex":"Er soll seinen Lebenslauf gefälscht haben.","exk":"그가 이력서를 위조했다고 해요.","ety":"falsch(틀린)에서 나온 동사","rel":[{"de":"die Fälschung","ko":"위조"},{"de":"manipulieren","ko":"조작하다"},{"de":"gefälscht","ko":"위조된"}],"pos":"동사"},"B2-1100":{"de":"erkranken","lv":"B2","forms":"erkrankt – ist erkrankt (+ an 3격)","ko":"병에 걸리다; 발병하다","ex":"Jedes Jahr erkranken tausende Menschen an Grippe.","exk":"매년 수천 명이 독감에 걸려요.","ety":"er-(상태 변화) + krank(아픈)","rel":[{"de":"die Erkrankung","ko":"질병"},{"de":"krank werden","ko":"아프게 되다"},{"de":"genesen","ko":"회복하다"}],"tip":"완료는 sein: \"Er ist an Grippe erkrankt.\"","pos":"동사"},"B2-1311":{"de":"die Zusammenfassung","lv":"B2","forms":"Pl. die Zusammenfassungen","ko":"요약","ex":"Schreiben Sie eine kurze Zusammenfassung des Artikels.","exk":"기사를 짧게 요약해 쓰세요.","ety":"zusammenfassen = zusammen(함께) + fassen(잡다), '한데 모아 잡다' · -ung 명사화","rel":[{"de":"zusammenfassen","ko":"요약하다"},{"de":"kurz","ko":"짧은"},{"de":"das