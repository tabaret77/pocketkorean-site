2533":{"de":"partizipativ","lv":"C1","ko":"참여적인; 참여형의","ex":"Partizipative Führung bezieht die Mitarbeiter aktiv in Entscheidungen ein.","exk":"참여형 리더십은 직원들을 의사 결정에 적극적으로 참여시켜요.","ety":"라틴어 participare(참여하다)에서","rel":[{"de":"die Partizipation","ko":"참여"},{"de":"die Beteiligung","ko":"참여"},{"de":"die Mitbestimmung","ko":"공동 결정"}],"pos":"형용사"},"C1-2850":{"de":"die Bestrahlung","lv":"C1","forms":"Pl. die Bestrahlungen","ko":"방사선 치료; 조사(照射)","ex":"Nach der Operation folgt eine mehrwöchige Bestrahlung.","exk":"수술 후 몇 주간의 방사선 치료가 이어져요.","ety":"bestrahlen = be- + der Strahl(광선), 광선을 비춤 · -ung 명사화","rel":[{"de":"die Strahlung","ko":"방사선"},{"de":"die Chemotherapie","ko":"항암 화학 요법"},{"de":"der Tumor","ko":"종양"}],"pos":"명사"},"C1-3758":{"de":"anfechtbar","lv":"C1","ko":"이의 제기 가능한; 논란의 여지가 있는","ex":"Der Bescheid ist innerhalb eines Monats anfechtbar.","exk":"그 처분은 한 달 안에 이의를 제기할 수 있어요.","ety":"an(~에 맞서) + fechten(싸우다, 검을 겨루다) → anfechten(이의를 제기하다) + -bar","rel":[{"de":"anfechten","ko":"이의를 제기하다"},{"de":"die Anfechtung","ko":"이의 제기"},{"de":"strittig","ko":"논쟁적인"}],"pos":"형용사"},"C1-3857":{"de":"die Profilbildung","lv":"C1","forms":"Sg.","ko":"프로파일링; (개인) 성향 분석","ex":"Werbekonzerne betreiben umfassende Profilbildung anhand unseres Klickverhaltens.","exk":"광고 기업들은 우리의 클릭 행동을 바탕으로 포괄적인 성향 분석을 해요.","ety":"das Profil(프로필) + die Bildung(형성)","rel":[{"de":"das Profil","ko":"프로필"},{"de":"das Tracking","ko":"추적"},{"de":"das Nutzerverhalten","ko":"사용자 행동"}],"pos":"명사"},"C1-3923":{"de":"regenerativ","lv":"C1","ko":"재생 가능한; 재생의","ex":"Bis 2030 soll der Strom überwiegend aus regenerativen Quellen stammen.","exk":"2030년까지 전기는 주로 재생 가능 에너지원에서 나와야 해요.","ety":"라틴어 regenerare(다시 낳다)에서","rel":[{"de":"erneuerbar","ko":"재생 가능한"},{"de":"fossil","ko":"화석의"},{"de":"nachhaltig","ko":"지속 가능한"}],"tip":"= erneuerbar · 'erneuerbare Energien'이 더 흔함","pos":"형용사"},"C1-4258":{"de":"der Dominoeffekt","lv":"C1","forms":"Pl. die Dominoeffekte","ko":"도미노 효과; 연쇄 반응","ex":"Die Pleite der Bank löste einen Dominoeffekt aus.","exk":"그 은행의 파산이 도미노 효과를 일으켰어요.","ety":"das Domino(도미노 게임) + der Effekt(효과)","rel":[{"de":"die Kettenreaktion","ko":"연쇄 반응"},{"de":"der Schneeballeffekt","ko":"눈덩이 효과"},{"de":"auslösen","ko":"촉발하다"}],"pos":"명사"},"C2-015":{"de":"der Habitus","lv":"C2","forms":"Pl. die Habitus (드묾)","ko":"(몸에 밴) 태도, 거동, 풍모","ex":"Sein großbürgerlicher Habitus verriet ihn, noch bevor er ein Wort gesagt hatte.","exk":"그가 한마디 하기도 전에 상류 시민계급다운 풍모가 그의 출신을 드러냈어요.","ety":"라틴어 habitus(태도, 외양)에서 · habere(가지다)와 관련","rel":[{"de":"die Haltung","ko":"태도, 자세"},{"de":"das Auftreten","ko":"처신, 거동"},{"de":"die Attitüde","ko":"태도, 포즈"}],"pos":"명사"},"C2-745":{"de":"dumm wie Bohnenstroh","lv":"C2","ko":"아주 멍청한; 머리가 텅 빈","ex":"Er ist zwar charmant, aber leider dumm wie Bohnenstroh.","exk":"그는 매력적이지만 안타깝게도 머리가 텅 비었어요.","ety":"콩줄기(Bohnenstroh)는 사료로도 쓸모없는 지푸라기였다는 데서 유래설","rel":[{"de":"strohdumm","ko":"몹시 멍청한"},{"de":"einfältig","ko":"단순한"},{"de":"begriffsstutzig","ko":"이해가 느린"}],"tip":"강한 경멸 표현 · 사용 주의","pos":"표현"},"C2-1476":{"de":"der Scharlatan","lv":"C2","forms":"Pl. die Scharlatane (여: die Scharlatanin)","ko":"사기꾼; 협잡꾼; 돌팔이","ex":"Der selbst ernannte Wunderheiler entpuppte sich als Scharlatan.","exk":"자칭 기적의 치유사는 협잡꾼으로 드러났어요.","ety":"이탈리아어 ciarlatano(떠버리 약장수)에서","rel":[{"de":"der Quacksalber","ko":"돌팔이 의사"},{"de":"der Hochstapler","ko":"사기꾼"},{"de":"die Scharlatanerie","ko":"협잡"}],"pos":"명사"},"C2-2068":{"de":"krepieren","lv":"C2","forms":"krepiert – ist krepiert","ko":"(비속) 뒈지다, 비참하게 죽다; (포탄이) 터지다","ex":"Die Tiere krepierten elend in den überhitzten Transportern.","exk":"동물들은 과열된 수송 차량 안에서 비참하게 죽어 갔어요.","ety":"이탈리아어 crepare(터지다)에서","rel":[{"de":"verenden","ko":"(동물이) 죽다"},{"de":"sterben","ko":"죽다"},{"de":"abkratzen","ko":"뒈지다"}],"tip":"⚠️ 사람에게 쓰면 매우 무례","pos":"동사"},"C2-2547":{"de":"hochjazzen","lv":"C2","forms":"jazzt hoch – hat hochgejazzt","ko":"(사소한 것을) 부풀려 띄우다; 과대 포장하다","ex":"Die Medien haben den kleinen Streit zum Koalitionsbruch hochgejazzt.","exk":"언론은 작은 다툼을 연정 붕괴로 부풀렸어요.","ety":"hoch(높이) + 