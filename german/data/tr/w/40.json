basitleştirmek"},{"de":"der Verwaltungsaufwand","ko":"idari yük"}],"pos":"fiil"},"C1-4174":{"de":"entschärfen","lv":"C1","forms":"entschärft – hat entschärft","ko":"yumuşatmak, yatıştırmak; (bombayı) etkisiz hale getirmek","ex":"Ein offenes Gespräch könnte den Konflikt entschärfen.","exk":"Açık bir konuşma çatışmayı yumuşatabilir.","ety":"ent- (giderme) + scharf (keskin) + -en","rel":[{"de":"verschärfen","ko":"kızıştırmak, ağırlaştırmak"},{"de":"abmildern","ko":"hafifletmek"},{"de":"die Entschärfung","ko":"yumuşatma; etkisizleştirme"}],"tip":"eine Bombe entschärfen = bombayı etkisiz hale getirmek","pos":"fiil"},"C1-4268":{"de":"die Zwischenbilanz","lv":"C1","forms":"Pl. die Zwischenbilanzen","ko":"ara bilanço, ara değerlendirme","ex":"Nach einem Jahr zieht die Regierung eine erste Zwischenbilanz.","exk":"Hükümet bir yılın sonunda ilk ara değerlendirmesini yapıyor.","ety":"zwischen (ara) + die Bilanz (bilanço)","rel":[{"de":"die Bilanz","ko":"bilanço"},{"de":"das Fazit","ko":"sonuç"},{"de":"die Bestandsaufnahme","ko":"durum tespiti"}],"tip":"Fiil ziehen: eine Zwischenbilanz ziehen","pos":"isim"},"C1-4372":{"de":"unangebracht","lv":"C1","ko":"yersiz, uygunsuz","ex":"Deine Bemerkung war völlig unangebracht.","exk":"Söylediğin tamamen yersizdi.","ety":"un- (değil) + angebracht (uygun, yerinde)","rel":[{"de":"angebracht","ko":"yerinde, uygun"},{"de":"unpassend","ko":"uygun düşmeyen"},{"de":"fehl am Platz","ko":"yersiz"}],"pos":"sıfat"},"C1-4800":{"de":"der Stickstoff","lv":"C1","forms":"Sg.","ko":"azot, nitrojen","ex":"Die Luft besteht zu etwa 78 Prozent aus Stickstoff.","exk":"Havanın yaklaşık yüzde 78'i azottur.","ety":"ersticken (boğulmak) + Stoff (madde)","rel":[{"de":"der Sauerstoff","ko":"oksijen"},{"de":"der Wasserstoff","ko":"hidrojen"},{"de":"das Element","ko":"element"}],"pos":"isim"},"C2-227":{"de":"der Kalauer","lv":"C2","forms":"Pl. die Kalauer","ko":"espri kıtlığı, bayık kelime oyunu","ex":"Mein Vater erzählt gern Kalauer.","exk":"Babam bayık espriler yapma